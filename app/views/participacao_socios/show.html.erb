<div class="sec-head">
  <div>
    <div class="sec-title">Detalhes da Participação</div>
    <div class="sec-sub">Informações da participação</div>
  </div>
  <div class="btn-row">
    <%= link_to "Editar", edit_participacao_socio_path(@participacao_socio), class: "btn btn-ghost" %>
    <%= link_to "Voltar", participacao_socios_path, class: "btn btn-ghost" %>
  </div>
</div>

<!-- Sócio -->
<div class="card">
  <div class="card-lbl">Sócio</div>
  <div class="frow">
    <div class="fg">
      <div class="fvalue">
        <div><%= @participacao_socio.socio.nome %></div>
        <div class="text-sm text-gray-600"><%= @participacao_socio.socio.cpf %></div>
        <div class="text-sm text-gray-600"><%= @participacao_socio.socio.telefone %></div>
        <div class="text-sm text-gray-600"><%= @participacao_socio.socio.email %></div>
      </div>
    </div>
  </div>
</div>

<!-- Participação -->
<div class="card">
  <div class="card-lbl">Participação</div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Percentual</div>
      <div class="fvalue"><%= @participacao_socio.percentual_participacao.to_f %>%</div>
    </div>
    <div class="fg">
      <div class="flabel">Valor Investido</div>
      <div class="fvalue">R$ <%= number_to_currency(@participacao_socio.valor_investido, unit: "", separator: ",", delimiter: ".") %></div>
    </div>
  </div>
</div>

<!-- Veículo -->
<div class="card">
  <div class="card-lbl">Veículo</div>
  <div class="frow">
    <div class="fg">
      <div class="fvalue">
        <div><%= @participacao_socio.veiculo.placa %> - <%= @participacao_socio.veiculo.modelo %></div>
        <div class="text-sm text-gray-600"><%= @participacao_socio.veiculo.marca %> <%= @participacao_socio.veiculo.ano %></div>
        <div class="text-sm text-gray-600">Cor: <%= @participacao_socio.veiculo.cor %></div>
        <div class="text-sm text-gray-600">KM Atual: <%= @participacao_socio.veiculo.km_atual %> km</div>
      </div>
    </div>
  </div>
</div>

<!-- Valores do Veículo -->
<div class="card">
  <div class="card-lbl">Valores do Veículo</div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Valor Compra</div>
      <div class="fvalue">R$ <%= number_to_currency(@participacao_socio.veiculo.valor_compra, unit: "", separator: ",", delimiter: ".") %></div>
    </div>
    <div class="fg">
      <div class="flabel">Valor Semanal</div>
      <div class="fvalue">R$ <%= number_to_currency(@participacao_socio.veiculo.valor_semanal, unit: "", separator: ",", delimiter: ".") %></div>
    </div>
  </div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Status</div>
      <div class="flex items-center gap-2">
        <span class="badge 
          <%= case @participacao_socio.veiculo.status 
              when 0 then 'b-green'
              when 1 then 'b-blue'
              when 2 then 'b-yellow'
              when 3 then 'b-red'
              end %>">
          <%= @participacao_socio.veiculo.status_text %>
        </span>
      </div>
    </div>
  </div>
</div>
