<% content_for :title, "Participações de Sócios | MotriX" %>

<section class="flex items-end justify-between gap-4">
  <div>
    <p class="text-sm font-medium uppercase tracking-[0.2em] text-teal-700">Participações</p>
    <h2 class="mt-1 text-3xl font-semibold text-stone-950">Participações de sócios na frota</h2>
  </div>
  <div class="flex items-center gap-3">
    <div class="rounded-full bg-white px-4 py-2 text-sm font-medium text-stone-600 ring-1 ring-stone-200">
      <%= @participacao_socios.size %> participações
    </div>
    <%= link_to "Nova Participação", new_participacao_socio_path, class: "rounded-full bg-teal-700 px-4 py-2 text-sm font-medium text-white hover:bg-teal-800 transition-colors" %>
  </div>
</section>

<section class="mt-6 space-y-4">
  <% @participacao_socios.each do |participacao| %>
    <article class="rounded-3xl border border-stone-200 bg-white p-5">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h3 class="text-lg font-semibold text-stone-950"><%= participacao.socio.nome %></h3>
          <p class="mt-1 text-sm text-stone-500"><%= participacao.socio.cpf %></p>
        </div>
        <div class="text-right">
          <p class="text-lg font-semibold text-stone-950"><%= participacao.percentual_participacao.to_f %>%</p>
          <p class="text-sm text-stone-600">Investimento: <%= number_to_currency(participacao.valor_investido, unit: "R$ ", separator: ",", delimiter: ".") %></p>
        </div>
      </div>

      <div class="mt-4 grid gap-3 text-sm text-stone-600 sm:grid-cols-2">
        <p><strong>Veículo:</strong> <%= participacao.veiculo.placa %> - <%= participacao.veiculo.modelo %></p>
        <p><strong>Ano:</strong> <%= participacao.veiculo.ano %></p>
        <p><strong>Valor Semanal:</strong> <%= number_to_currency(participacao.veiculo.valor_semanal, unit: "R$ ", separator: ",", delimiter: ".") %></p>
        <p><strong>Status:</strong> <%= participacao.veiculo.status_text %></p>
      </div>

      <div class="mt-4 flex justify-end">
        <%= link_to "Ver Detalhes", participacao_socio_path(participacao), class: "text-sm font-medium text-teal-700 hover:text-teal-800" %>
      </div>
    </article>
  <% end %>
</section>
