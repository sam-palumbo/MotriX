<% content_for :title, "Participações | MotriX" %>

<div class="sec-head">
  <div>
    <div class="sec-title">Participações</div>
    <div class="sec-sub"><%= @participacao_socios.size %> participações ativas</div>
  </div>
  <%= link_to "Nova Participação", "#", onclick: "AppModal.load('#{new_participacao_socio_path}', 'Nova Participação', 'Adicionar investimento de sócio'); return false;", class: "btn btn-gold btn-sm" %>
</div>

<!-- Quick Stats -->
<div class="kgrid">
  <div class="kcard">
    <div class="knum" style="color:var(--gold)">
      <%= @participacao_socios.count %>
    </div>
    <div class="kdesc">Total</div>
  </div>
  <div class="kcard">
    <div class="knum" style="color:var(--green)">
      <%= brl(@participacao_socios.sum(:valor_investido)) %>
    </div>
    <div class="kdesc">Investido</div>
  </div>
  <div class="kcard">
    <div class="knum" style="font-size:20px">
      <%= @participacao_socios.sum(:percentual_participacao).to_f %>%
    </div>
    <div class="kdesc">Participação</div>
  </div>
  <div class="kcard">
    <div class="knum" style="color:var(--blue)">
      <%= @participacao_socios.joins(:veiculo).where(veiculos: { status: :disponivel }).count %>
    </div>
    <div class="kdesc">Disponíveis</div>
  </div>
</div>

<!-- Tabs -->
<div class="tabs">
  <button class="tab active" onclick="filterParticipacoes('todos', this)">Todas</button>
  <button class="tab" onclick="filterParticipacoes('disponivel', this)">Disponíveis</button>
  <button class="tab" onclick="filterParticipacoes('locado', this)">Locados</button>
  <button class="tab" onclick="filterParticipacoes('manutencao', this)">Manutenção</button>
</div>

<div id="participacoes-list">
  <% @participacao_socios.each do |participacao| %>
    <% valor_semanal = participacao.veiculo.valor_semanal || 0 %>
    <% retorno_semanal = valor_semanal * participacao.percentual_participacao.to_f / 100 %>
    <div class="vcard" data-status="<%= participacao.veiculo.status %>" onclick="window.location.href='<%= participacao_socio_path(participacao) %>'">
      <div class="vc-head">
        <div class="vc-plate"><%= participacao.veiculo.placa %></div>
        <div class="flex1" style="padding-left:4px">
          <div style="font-size:12px;font-weight:600;line-height:1.4">
            <%= participacao.socio.nome %> • <%= participacao.veiculo.modelo %>
          </div>
          <div style="margin-top:4px;display:flex;gap:5px;flex-wrap:wrap">
            <span class="badge b-gold">
              <%= participacao.percentual_participacao.to_f %>%
            </span>
            <span class="badge <%= participacao.veiculo.status == 'disponivel' ? 'b-green' : participacao.veiculo.status == 'locado' ? 'b-blue' : 'b-orange' %>">
              <%= participacao.veiculo.status_text %>
            </span>
          </div>
        </div>
      </div>
      <div class="vc-body">
        <div class="vc-stats">
          <div class="vc-stat">
            <div class="vc-sn" style="color:var(--green)"><%= brl(participacao.valor_investido) %></div>
            <div class="vc-sl">investido</div>
          </div>
          <div class="vc-stat">
            <div class="vc-sn" style="font-size:11px"><%= brl(valor_semanal) %></div>
            <div class="vc-sl">/semana</div>
          </div>
          <div class="vc-stat">
            <div class="vc-sn" style="color:var(--gold)">
              <%= brl(retorno_semanal) %>
            </div>
            <div class="vc-sl">/semana</div>
          </div>
        </div>
        
        <div class="vc-client">
          <span style="color:var(--text3)">Retorno mensal estimado</span>
          <span style="font-weight:600">
            <%= brl(retorno_semanal * 4) %>
          </span>
        </div>
      </div>
    </div>
  <% end %>
  
  <% if @participacao_socios.empty? %>
    <div class="empty">
      <div class="empty-ico">⏱️</div>
      <div style="font-size:13px">Nenhuma participação cadastrada</div>
    </div>
  <% end %>
</div>

<script>
function filterParticipacoes(status, element) {
  // Update active tab
  document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('active'));
  element.classList.add('active');
  
  // Filter participacoes
  const participacoes = document.querySelectorAll('.vcard');
  participacoes.forEach(participacao => {
    if (status === 'todos') {
      participacao.style.display = 'block';
    } else {
      participacao.style.display = participacao.dataset.status === status ? 'block' : 'none';
    }
  });
}
</script>
