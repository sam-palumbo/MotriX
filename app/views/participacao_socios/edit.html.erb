<div class="sec-head">
  <div>
    <div class="sec-title">Editar Participação</div>
    <div class="sec-sub">Atualizar informações da participação</div>
  </div>
</div>

<%= form_with(model: @participacao_socio, local: true, class: "max-w-2xl") do |form| %>
  <% if @participacao_socio.errors.any? %>
    <div class="alert a-red">
      <div class="a-icon">⚠</div>
      <div>
        <div class="a-title">Erros no formulário</div>
        <div class="a-sub">
          <% @participacao_socio.errors.full_messages.each do |message| %>
            • <%= message %><br>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Participação -->
  <div class="card">
    <div class="card-lbl">Participação</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :socio_id, "Sócio", class: "flabel" %>
        <%= form.select :socio_id, 
            options_from_collection_for_select(@socios, :id, :nome, @participacao_socio.socio_id), 
            { prompt: "Selecione um sócio" }, 
            class: "fselect" %>
      </div>
      <div class="fg">
        <%= form.label :veiculo_id, "Veículo", class: "flabel" %>
        <%= form.select :veiculo_id, 
            options_from_collection_for_select(@veiculos, :id, :placa_modelo, @participacao_socio.veiculo_id), 
            { prompt: "Selecione um veículo" }, 
            class: "fselect" %>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <%= form.label :percentual_participacao, "Percentual de Participação", class: "flabel" %>
        <%= form.number_field :percentual_participacao, step: 0.01, min: 0, max: 100, class: "finput", placeholder: "50.00" %>
      </div>
      <div class="fg">
        <%= form.label :valor_investido, "Valor Investido", class: "flabel" %>
        <%= form.number_field :valor_investido, step: 0.01, class: "finput", placeholder: "0.00" %>
      </div>
    </div>
  </div>

  <!-- Botões -->
  <div class="btn-row">
    <%= link_to "Cancelar", @participacao_socio, class: "btn btn-ghost" %>
    <%= form.submit "Atualizar Participação", class: "btn btn-gold" %>
  </div>
<% end %>
