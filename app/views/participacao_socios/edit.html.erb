<div class="max-w-2xl mx-auto">
  <div class="bg-white shadow-sm rounded-lg">
    <div class="px-6 py-4 border-b border-gray-200">
      <h1 class="text-xl font-semibold text-gray-900">Editar Participação de Sócio</h1>
    </div>
    
    <div class="px-6 py-4">
      <%= form_with(model: @participacao_socio, local: true, class: "space-y-6") do |form| %>
        <% if @participacao_socio.errors.any? %>
          <div class="rounded-md bg-red-50 p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  <%= pluralize(@participacao_socio.errors.count, "error") %> prohibited this participacao_socio from being saved:
                </h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul class="list-disc list-inside">
                    <% @participacao_socio.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <%= form.label :socio_id, "Sócio", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :socio_id, options_from_collection_for_select(@socios, :id, :nome, @participacao_socio.socio_id), { prompt: "Selecione um sócio" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :veiculo_id, "Veículo", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :veiculo_id, options_from_collection_for_select(@veiculos, :id, :placa_modelo, @participacao_socio.veiculo_id), { prompt: "Selecione um veículo" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :percentual_participacao, "Percentual de Participação", class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :percentual_participacao, step: 0.01, min: 0, max: 100, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
            <p class="mt-1 text-sm text-gray-500">Informe o percentual de participação (ex: 50.00 para 50%)</p>
          </div>

          <div>
            <%= form.label :valor_investido, "Valor Investido", class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :valor_investido, step: 0.01, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>
        </div>

        <div class="flex justify-end space-x-3">
          <%= link_to "Cancelar", @participacao_socio, class: "px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          <%= form.submit "Atualizar Participação", class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
