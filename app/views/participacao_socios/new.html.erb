<div class="sec-head">
  <div>
    <div class="sec-title">Nova Participação</div>
    <div class="sec-sub">Adicionar investimento de sócio</div>
  </div>
</div>

<%= form_with(model: @participacao_socio, local: true, class: "max-w-2xl") do |form| %>
  <% if @participacao_socio.errors.any? %>
    <div class="alert a-red">
      <div class="a-icon">⚠</div>
      <div>
        <div class="a-title">Erros no formulário</div>
        <div class="a-sub">
          <% @participacao_socio.errors.full_messages.each do |message| %>
            • <%= message %><br>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Participação -->
  <div class="card">
    <div class="card-lbl">Dados da Participação</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :socio_id, "Sócio", class: "flabel" %>
        <%= form.select :socio_id, 
            options_from_collection_for_select(@socios, :id, :nome, @participacao_socio.socio_id), 
            { prompt: "Selecione um sócio" }, 
            class: "fselect" %>
      </div>
      <div class="fg">
        <%= form.label :veiculo_id, "Veículo", class: "flabel" %>
        <%= form.select :veiculo_id, 
            options_from_collection_for_select(@veiculos, :id, :placa_modelo, @participacao_socio.veiculo_id), 
            { prompt: "Selecione um veículo" }, 
            class: "fselect" %>
      </div>
    </div>
  </div>

  <!-- Valores -->
  <div class="card">
    <div class="card-lbl">Valores Financeiros</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :percentual_participacao, "Percentual de Participação (%)", class: "flabel" %>
        <%= form.number_field :percentual_participacao, step: 0.01, min: 0, max: 100, class: "finput", placeholder: "50.00" %>
        <div style="font-size:11px;color:var(--text3);margin-top:4px">Informe o percentual (ex: 50.00 para 50%)</div>
      </div>
      <div class="fg">
        <%= form.label :valor_investido, "Valor Investido (R$)", class: "flabel" %>
        <%= form.number_field :valor_investido, step: 0.01, class: "finput", placeholder: "5.000,00" %>
      </div>
    </div>
  </div>

  <!-- Cálculo Estimado -->
  <div class="card" style="background:var(--bg3);border:1px solid var(--border2)">
    <div class="card-lbl">📊 Estimativa de Retorno</div>
    <div class="frow">
      <div class="fg">
        <div class="finfo">
          <div class="finfo-lbl">Retorno Semanal</div>
          <div class="finfo-val" id="retorno-semanal">R$ 0,00</div>
        </div>
      </div>
      <div class="fg">
        <div class="finfo">
          <div class="finfo-lbl">Retorno Mensal</div>
          <div class="finfo-val" id="retorno-mensal">R$ 0,00</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Botões -->
  <div class="btn-row">
    <%= link_to "Cancelar", participacao_socios_path, class: "btn btn-ghost" %>
    <%= form.submit "Criar Participação", class: "btn btn-gold" %>
  </div>
<% end %>

<script>
// Simple calculation preview
document.addEventListener('DOMContentLoaded', function() {
  const percentualInput = document.querySelector('#participacao_socio_percentual_participacao');
  const valorInput = document.querySelector('#participacao_socio_valor_investido');
  const semanalEl = document.getElementById('retorno-semanal');
  const mensalEl = document.getElementById('retorno-mensal');
  
  function updateEstimativa() {
    const percentual = parseFloat(percentualInput.value) || 0;
    const valor = parseFloat(valorInput.value) || 0;
    
    // This is just a placeholder calculation - you'd need actual vehicle data
    const valorSemanalEstimado = (valor * 0.01); // 1% weekly return example
    const valorMensalEstimado = valorSemanalEstimado * 4 * (percentual / 100);
    
    semanalEl.textContent = `R$ ${valorSemanalEstimado.toFixed(2).replace('.', ',')}`;
    mensalEl.textContent = `R$ ${valorMensalEstimado.toFixed(2).replace('.', ',')}`;
  }
  
  if (percentualInput && valorInput) {
    percentualInput.addEventListener('input', updateEstimativa);
    valorInput.addEventListener('input', updateEstimativa);
  }
});
</script>
