<!-- List of Uploaded Files from Google Drive -->
<% if anexos&.any? %>
  <div style="margin-top: 20px;">
    <div style="font-weight: 600; margin-bottom: 12px; color: var(--text);">
      <%= icon "paperclip", size: 16, style: "vertical-align: middle;" %> 
      Documentos Anexados (<%= anexos.count %>)
    </div>
    
    <div style="display: grid; gap: 8px;">
      <% anexos.each do |anexo| %>
        <div style="display: flex; align-items: center; gap: 12px; padding: 12px; background: var(--bg2); border-radius: 8px; border: 1px solid var(--border);">
          <!-- File Icon based on type -->
          <div style="flex-shrink: 0; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: var(--bg3); border-radius: 6px; font-size: 20px;">
            <% case anexo.mime_type %>
            <% when /pdf/ %>
              📄
            <% when /image/ %>
              🖼️
            <% when /word/ %>
              📝
            <% when /zip/ %>
              📦
            <% else %>
              📎
            <% end %>
          </div>
          
          <!-- File Info -->
          <div style="flex: 1; min-width: 0;">
            <div style="font-weight: 500; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
              <%= anexo.nome_arquivo %>
            </div>
            <div style="font-size: 12px; color: var(--text3); margin-top: 2px;">
              <span class="badge b-gold" style="font-size: 10px;"><%= anexo.categoria %></span>
              <span style="margin-left: 8px;">
                <%= anexo.created_at.strftime("%d/%m/%Y %H:%M") %>
              </span>
              <% if anexo.evento.present? %>
                <span style="margin-left: 8px; color: var(--gold);">
                  • <%= anexo.evento.tipo_evento_text %>
                </span>
              <% end %>
            </div>
          </div>
          
          <!-- Actions -->
          <div style="display: flex; gap: 8px; flex-shrink: 0;">
            <%= link_to anexo.arquivo_url, 
                target: "_blank", 
                class: "btn btn-ghost", 
                style: "font-size: 12px; padding: 4px 8px;",
                title: "Visualizar no Google Drive" do %>
              <%= icon "external-link", size: 14 %> Abrir
            <% end %>
            
            <%= button_to veiculo_anexo_path(veiculo, anexo), 
                method: :delete, 
                class: "btn btn-ghost", 
                style: "font-size: 12px; padding: 4px 8px; color: var(--red);",
                title: "Remover",
                data: { confirm: "Tem certeza que deseja remover este arquivo?" } do %>
              <%= icon "trash", size: 14 %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <div style="margin-top: 20px; padding: 20px; text-align: center; background: var(--bg2); border-radius: 8px; border: 1px dashed var(--border);">
    <div style="font-size: 24px; margin-bottom: 8px;">📎</div>
    <div style="color: var(--text3); font-size: 14px;">
      Nenhum documento anexado
    </div>
    <div style="color: var(--text3); font-size: 12px; margin-top: 4px;">
      Use o formulário acima para enviar arquivos
    </div>
  </div>
<% end %>
