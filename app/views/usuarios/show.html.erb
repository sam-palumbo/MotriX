<div class="max-w-4xl mx-auto">
  <div class="bg-white shadow-sm rounded-lg">
    <div class="px-6 py-4 border-b border-gray-200">
      <div class="flex items-center justify-between">
        <h1 class="text-xl font-semibold text-gray-900">Detalhes do Usuário</h1>
        <div class="flex space-x-2">
          <%= link_to "Editar", edit_usuario_path(@usuario), class: "px-3 py-1 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          <%= link_to "Voltar", usuarios_path, class: "px-3 py-1 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        </div>
      </div>
    </div>
    
    <div class="px-6 py-4">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="space-y-4">
          <div>
            <h3 class="text-sm font-medium text-gray-500">Informações Pessoais</h3>
            <div class="mt-2 space-y-2">
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Nome:</span>
                <span class="text-sm font-medium text-gray-900"><%= @usuario.nome %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">CPF:</span>
                <span class="text-sm font-medium text-gray-900"><%= @usuario.cpf %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Email:</span>
                <span class="text-sm font-medium text-gray-900"><%= @usuario.email %></span>
              </div>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-medium text-gray-500">Acesso</h3>
            <div class="mt-2 space-y-2">
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Perfil:</span>
                <span class="px-2 py-1 text-xs font-medium rounded-full 
                  <%= @usuario.admin? ? 'bg-purple-100 text-purple-800' : 'bg-blue-100 text-blue-800' %>">
                  <%= @usuario.perfil_text %>
                </span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Status:</span>
                <span class="px-2 py-1 text-xs font-medium rounded-full <%= @usuario.ativo? ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                  <%= @usuario.ativo? ? 'Ativo' : 'Inativo' %>
                </span>
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-4">
          <div>
            <h3 class="text-sm font-medium text-gray-500">Resumo de Atividade</h3>
            <div class="mt-2 space-y-2">
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Data de Cadastro:</span>
                <span class="text-sm font-medium text-gray-900"><%= @usuario.created_at.strftime("%d/%m/%Y") %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Última Atualização:</span>
                <span class="text-sm font-medium text-gray-900"><%= @usuario.updated_at.strftime("%d/%m/%Y %H:%M") %></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-6 pt-6 border-t border-gray-200">
        <div class="flex justify-between items-center text-sm text-gray-500">
          <div>
            Criado em: <%= @usuario.created_at.strftime("%d/%m/%Y %H:%M") %>
          </div>
          <div>
            Atualizado em: <%= @usuario.updated_at.strftime("%d/%m/%Y %H:%M") %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
