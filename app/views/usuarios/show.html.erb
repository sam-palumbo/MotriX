<div class="sec-head">
  <div>
    <div class="sec-title">Detalhes do Usuário</div>
    <div class="sec-sub">Informações do usuário</div>
  </div>
  <div class="btn-row">
    <%= link_to "Editar", edit_usuario_path(@usuario), class: "btn btn-ghost" %>
    <%= link_to "Voltar", usuarios_path, class: "btn btn-ghost" %>
  </div>
</div>

<!-- Informações Pessoais -->
<div class="card">
  <div class="card-lbl">Informações Pessoais</div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Nome</div>
      <div class="fvalue"><%= @usuario.nome %></div>
    </div>
    <div class="fg">
      <div class="flabel">CPF</div>
      <div class="fvalue"><%= @usuario.cpf %></div>
    </div>
  </div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Email</div>
      <div class="fvalue"><%= @usuario.email %></div>
    </div>
  </div>
</div>

<!-- Acesso -->
<div class="card">
  <div class="card-lbl">Acesso</div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Perfil</div>
      <div class="flex items-center gap-2">
        <span class="badge <%= @usuario.perfil_admin? ? 'b-blue' : 'b-gray' %>">
          <%= @usuario.perfil_text %>
        </span>
      </div>
    </div>
    <div class="fg">
      <div class="flabel">Status</div>
      <div class="flex items-center gap-2">
        <span class="badge <%= @usuario.ativo? ? 'b-green' : 'b-red' %>">
          <%= @usuario.ativo? ? 'Ativo' : 'Inativo' %>
        </span>
      </div>
    </div>
  </div>
</div>

<!-- Resumo de Atividade -->
<div class="card">
  <div class="card-lbl">Resumo de Atividade</div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Data de Cadastro</div>
      <div class="fvalue"><%= @usuario.created_at.strftime("%d/%m/%Y") %></div>
    </div>
    <div class="fg">
      <div class="flabel">Última Atualização</div>
      <div class="fvalue"><%= @usuario.updated_at.strftime("%d/%m/%Y %H:%M") %></div>
    </div>
  </div>
</div>
