<% content_for :title, "Usuários | MotriX" %>

<div class="sec-head">
  <div>
    <div class="sec-title">Usuários</div>
    <div class="sec-sub"><%= @usuarios.size %> usuários cadastrados</div>
  </div>
  <%= link_to "Novo Usuário", new_usuario_path, class: "btn btn-gold btn-sm" %>
</div>

<!-- Quick Stats -->
<div class="kgrid">
  <div class="kcard">
    <div class="knum" style="color:var(--green)">
      <%= @usuarios.where(ativo: true).count %>
    </div>
    <div class="kdesc">Ativos</div>
  </div>
  <div class="kcard">
    <div class="knum" style="color:var(--red)">
      <%= @usuarios.where(ativo: false).count %>
    </div>
    <div class="kdesc">Inativos</div>
  </div>
  <div class="kcard">
    <div class="knum" style="color:var(--blue)">
      <%= @usuarios.where(perfil: 0).count %>
    </div>
    <div class="kdesc">Administradores</div>
  </div>
  <div class="kcard">
    <div class="knum" style="font-size:20px">
      <%= @usuarios.where(perfil: 1).count %>
    </div>
    <div class="kdesc">Operadores</div>
  </div>
</div>

<!-- Search/Filter -->
<div class="card">
  <div class="fg">
    <input type="text" class="finput" placeholder="🔍 Buscar usuário por nome, email ou CPF..." id="usuario-search">
  </div>
</div>

<div id="usuarios-list">
  <% @usuarios.each do |usuario| %>
    <div class="li" onclick="window.location.href='<%= usuario_path(usuario) %>'" data-search-text="<%= usuario.nome.downcase %> <%= usuario.email %> <%= usuario.cpf %>">
      <div class="li-icon" style="background:<%= usuario.ativo? ? 'rgba(61,186,110,.1)' : 'rgba(224,80,80,.1)' %>">
        <%= usuario.ativo? ? '✅' : '🔴' %>
      </div>
      <div class="li-body">
        <div class="li-title"><%= usuario.nome %></div>
        <div class="li-sub">
          <%= usuario.email %>
        </div>
        <div class="mt4">
          <span class="badge <%= usuario.perfil == 0 ? 'b-blue' : 'b-gray' %>">
            <%= usuario.perfil == 0 ? 'Administrador' : 'Operador' %>
          </span>
                  </div>
      </div>
      <div class="li-right">
        <span class="badge <%= usuario.ativo? ? 'b-green' : 'b-red' %>">
          <%= usuario.ativo? ? 'Ativo' : 'Inativo' %>
        </span>
      </div>
    </div>
  <% end %>
  
  <% if @usuarios.empty? %>
    <div class="empty">
      <div class="empty-ico">👤</div>
      <div style="font-size:13px">Nenhum usuário cadastrado</div>
    </div>
  <% end %>
</div>

<script>
document.getElementById('usuario-search').addEventListener('input', function(e) {
  const searchTerm = e.target.value.toLowerCase();
  const usuarios = document.querySelectorAll('#usuarios-list .li');
  
  usuarios.forEach(usuario => {
    const searchText = usuario.dataset.searchText;
    if (searchText.includes(searchTerm)) {
      usuario.style.display = 'flex';
    } else {
      usuario.style.display = 'none';
    }
  });
});
</script>
