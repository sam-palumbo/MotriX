<% content_for :title, "Usuários | MotriX" %>

<section class="flex items-end justify-between gap-4">
  <div>
    <p class="text-sm font-medium uppercase tracking-[0.2em] text-teal-700">Usuários</p>
    <h2 class="mt-1 text-3xl font-semibold text-stone-950">Gestão de usuários</h2>
  </div>
  <div class="flex items-center gap-3">
    <div class="rounded-full bg-white px-4 py-2 text-sm font-medium text-stone-600 ring-1 ring-stone-200">
      <%= @usuarios.size %> usuários
    </div>
    <%= link_to "Novo Usuário", new_usuario_path, class: "rounded-full bg-teal-700 px-4 py-2 text-sm font-medium text-white hover:bg-teal-800 transition-colors" %>
  </div>
</section>

<section class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
  <% @usuarios.each do |usuario| %>
    <article class="rounded-3xl border border-stone-200 bg-white p-5">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h3 class="text-lg font-semibold text-stone-950"><%= usuario.nome %></h3>
          <p class="mt-1 text-sm text-stone-500"><%= usuario.cpf %></p>
        </div>
        <div class="flex flex-col items-end gap-2">
          <span class="rounded-full px-3 py-1 text-xs font-semibold <%= usuario.ativo? ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
            <%= usuario.ativo? ? 'Ativo' : 'Inativo' %>
          </span>
          <span class="rounded-full px-3 py-1 text-xs font-semibold bg-blue-100 text-blue-800">
            <%= usuario.perfil_text %>
          </span>
        </div>
      </div>
      <div class="mt-4 space-y-2 text-sm text-stone-600">
        <p><strong>Email:</strong> <%= usuario.email %></p>
        <p><strong>Telefone:</strong> <%= usuario.telefone.presence || "-" %></p>
      </div>
      <div class="mt-4 flex justify-end">
        <%= link_to "Ver Detalhes", usuario_path(usuario), class: "text-sm font-medium text-teal-700 hover:text-teal-800" %>
      </div>
    </article>
  <% end %>
</section>
