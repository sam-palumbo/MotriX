<div class="sec-head">
  <div>
    <div class="sec-title">Editar Usuário</div>
    <div class="sec-sub">Atualizar informações do usuário</div>
  </div>
</div>

<%= form_with(model: @usuario, local: true, class: "max-w-2xl") do |form| %>
  <% if @usuario.errors.any? %>
    <div class="alert a-red">
      <div class="a-icon">⚠</div>
      <div>
        <div class="a-title">Erros no formulário</div>
        <div class="a-sub">
          <% @usuario.errors.full_messages.each do |message| %>
            • <%= message %><br>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Dados Pessoais -->
  <div class="card">
    <div class="card-lbl">Dados Pessoais</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :nome, "Nome Completo", class: "flabel" %>
        <%= form.text_field :nome, class: "finput", placeholder: "Nome completo do usuário" %>
      </div>
      <div class="fg">
        <%= form.label :cpf, "CPF", class: "flabel" %>
        <%= form.text_field :cpf, class: "finput", placeholder: "000.000.000-00" %>
      </div>
    </div>
  </div>

  <!-- Credenciais -->
  <div class="card">
    <div class="card-lbl">Credenciais de Acesso</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :email, "Email", class: "flabel" %>
        <%= form.email_field :email, class: "finput", placeholder: "email@exemplo.com" %>
      </div>
      <div class="fg">
        <%= form.label :password, "Senha", class: "flabel" %>
        <%= form.password_field :password, class: "finput", placeholder: "Deixe em branco para manter a atual" %>
      </div>
    </div>
  </div>

  <!-- Permissões -->
  <div class="card">
    <div class="card-lbl">Permissões</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :perfil, "Perfil de Acesso", class: "flabel" %>
        <%= form.select :perfil, 
            options_for_select([
              ["Administrador", 0], 
              ["Operador", 1],
              ["Sócio", 2]
            ], @usuario.perfil), 
            {}, class: "fselect" %>
      </div>
      <div class="fg" style="display:flex;align-items:center;gap:8px;padding-top:20px">
        <%= form.check_box :ativo, class: "form-check-input", style: "width:18px;height:18px;accent-color:var(--gold)" %>
        <%= form.label :ativo, "Usuário Ativo", class: "flabel", style: "margin:0;font-weight:500" %>
      </div>
    </div>
  </div>

  <!-- Botões -->
  <div class="btn-row">
    <%= link_to "Cancelar", @usuario, class: "btn btn-ghost" %>
    <%= form.submit "Atualizar Usuário", class: "btn btn-gold" %>
  </div>
<% end %>
