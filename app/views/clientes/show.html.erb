<div class="sec-head">
  <div>
    <div class="sec-title">Detalhes do Cliente</div>
    <div class="sec-sub">Informações do cliente</div>
  </div>
  <div class="btn-row">
    <%= link_to "Editar", edit_cliente_path(@cliente), class: "btn btn-ghost" %>
    <%= link_to "Voltar", clientes_path, class: "btn btn-ghost" %>
  </div>
</div>

<!-- Informações Pessoais -->
<div class="card">
  <div class="card-lbl">Informações Pessoais</div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Nome</div>
      <div class="fvalue"><%= @cliente.nome %></div>
    </div>
    <div class="fg">
      <div class="flabel">CPF</div>
      <div class="fvalue"><%= @cliente.cpf %></div>
    </div>
  </div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Telefone</div>
      <div class="fvalue"><%= @cliente.telefone %></div>
    </div>
    <div class="fg">
      <div class="flabel">Email</div>
      <div class="fvalue"><%= @cliente.email %></div>
    </div>
  </div>
</div>

<!-- CNH -->
<div class="card">
  <div class="card-lbl">CNH</div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Número da CNH</div>
      <div class="fvalue"><%= @cliente.cnh %></div>
    </div>
    <div class="fg">
      <div class="flabel">Validade</div>
      <div class="fvalue"><%= @cliente.validade_cnh&.strftime("%d/%m/%Y") %></div>
    </div>
  </div>
</div>

<!-- Endereço -->
<div class="card">
  <div class="card-lbl">Endereço</div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Endereço</div>
      <div class="fvalue"><%= @cliente.endereco %></div>
    </div>
    <div class="fg">
      <div class="flabel">Cidade</div>
      <div class="fvalue"><%= @cliente.cidade %></div>
    </div>
  </div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Estado</div>
      <div class="fvalue"><%= @cliente.estado %></div>
    </div>
    <div class="fg">
      <div class="flabel">CEP</div>
      <div class="fvalue"><%= @cliente.cep %></div>
    </div>
  </div>
</div>

<!-- Status -->
<div class="card">
  <div class="card-lbl">Status</div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Situação</div>
      <div class="flex items-center gap-2">
        <span class="badge <%= @cliente.ativo? ? 'b-green' : 'b-red' %>">
          <%= @cliente.ativo? ? 'Ativo' : 'Inativo' %>
        </span>
      </div>
    </div>
  </div>
</div>

<% if @cliente.observacoes.present? %>
<!-- Observações -->
<div class="card">
  <div class="card-lbl">Observações</div>
  <div class="frow">
    <div class="fg">
      <div class="fvalue"><%= @cliente.observacoes %></div>
    </div>
  </div>
</div>
<% end %>
