<div class="max-w-4xl mx-auto">
  <div class="bg-white shadow-sm rounded-lg">
    <div class="px-6 py-4 border-b border-gray-200">
      <div class="flex items-center justify-between">
        <h1 class="text-xl font-semibold text-gray-900">Detalhes do Cliente</h1>
        <div class="flex space-x-2">
          <%= link_to "Editar", edit_cliente_path(@cliente), class: "px-3 py-1 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          <%= link_to "Voltar", clientes_path, class: "px-3 py-1 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        </div>
      </div>
    </div>
    
    <div class="px-6 py-4">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="space-y-4">
          <div>
            <h3 class="text-sm font-medium text-gray-500">Informações Pessoais</h3>
            <div class="mt-2 space-y-2">
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Nome:</span>
                <span class="text-sm font-medium text-gray-900"><%= @cliente.nome %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">CPF:</span>
                <span class="text-sm font-medium text-gray-900"><%= @cliente.cpf %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Telefone:</span>
                <span class="text-sm font-medium text-gray-900"><%= @cliente.telefone %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Email:</span>
                <span class="text-sm font-medium text-gray-900"><%= @cliente.email %></span>
              </div>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-medium text-gray-500">CNH</h3>
            <div class="mt-2 space-y-2">
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">CNH:</span>
                <span class="text-sm font-medium text-gray-900"><%= @cliente.cnh %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Validade:</span>
                <span class="text-sm font-medium text-gray-900"><%= @cliente.validade_cnh&.strftime("%d/%m/%Y") %></span>
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-4">
          <div>
            <h3 class="text-sm font-medium text-gray-500">Endereço</h3>
            <div class="mt-2 space-y-2">
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Endereço:</span>
                <span class="text-sm font-medium text-gray-900"><%= @cliente.endereco %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Cidade:</span>
                <span class="text-sm font-medium text-gray-900"><%= @cliente.cidade %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Estado:</span>
                <span class="text-sm font-medium text-gray-900"><%= @cliente.estado %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">CEP:</span>
                <span class="text-sm font-medium text-gray-900"><%= @cliente.cep %></span>
              </div>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-medium text-gray-500">Status</h3>
            <div class="mt-2">
              <span class="px-2 py-1 text-xs font-medium rounded-full <%= @cliente.ativo? ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                <%= @cliente.ativo? ? 'Ativo' : 'Inativo' %>
              </span>
            </div>
          </div>
        </div>
      </div>

      <% if @cliente.observacoes.present? %>
        <div class="mt-6">
          <h3 class="text-sm font-medium text-gray-500">Observações</h3>
          <div class="mt-2">
            <p class="text-sm text-gray-900"><%= @cliente.observacoes %></p>
          </div>
        </div>
      <% end %>

      <div class="mt-6 pt-6 border-t border-gray-200">
        <div class="flex justify-between items-center text-sm text-gray-500">
          <div>
            Criado em: <%= @cliente.created_at.strftime("%d/%m/%Y %H:%M") %>
          </div>
          <div>
            Atualizado em: <%= @cliente.updated_at.strftime("%d/%m/%Y %H:%M") %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
