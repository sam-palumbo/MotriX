<div class="sec-head">
  <div>
    <div class="sec-title">Novo Cliente</div>
    <div class="sec-sub">Adicionar cliente à base</div>
  </div>
</div>

<%= form_with(model: @cliente, local: true, class: "max-w-2xl") do |form| %>
  <% if @cliente.errors.any? %>
    <div class="alert a-red">
      <div class="a-icon">⚠</div>
      <div>
        <div class="a-title">Erros no formulário</div>
        <div class="a-sub">
          <% @cliente.errors.full_messages.each do |message| %>
            • <%= message %><br>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Dados Pessoais -->
  <div class="card">
    <div class="card-lbl">Dados Pessoais</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :nome, "Nome Completo *", class: "flabel" %>
        <%= form.text_field :nome, class: "finput", placeholder: "João Silva", required: true %>
      </div>
      <div class="fg">
        <%= form.label :cpf, "CPF *", class: "flabel" %>
        <%= form.text_field :cpf, class: "finput", placeholder: "000.000.000-00", required: true %>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <%= form.label :telefone, "Telefone", class: "flabel" %>
        <%= form.text_field :telefone, class: "finput", placeholder: "(11) 99999-9999" %>
      </div>
      <div class="fg">
        <%= form.label :email, "Email", class: "flabel" %>
        <%= form.email_field :email, class: "finput", placeholder: "joao@email.com" %>
      </div>
    </div>
  </div>

  <!-- Documentos -->
  <div class="card">
    <div class="card-lbl">Documentos</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :cnh, "CNH", class: "flabel" %>
        <%= form.text_field :cnh, class: "finput", placeholder: "00000000000" %>
      </div>
      <div class="fg">
        <%= form.label :validade_cnh, "Validade CNH", class: "flabel" %>
        <%= form.date_field :validade_cnh, class: "finput" %>
      </div>
    </div>
  </div>

  <!-- Endereço -->
  <div class="card">
    <div class="card-lbl">Endereço</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :cep, "CEP", class: "flabel" %>
        <%= form.text_field :cep, class: "finput", placeholder: "00000-000" %>
      </div>
      <div class="fg">
        <%= form.label :estado, "Estado", class: "flabel" %>
        <%= form.text_field :estado, class: "finput", placeholder: "SP" %>
      </div>
    </div>
    <div class="fg">
      <%= form.label :endereco, "Endereço", class: "flabel" %>
      <%= form.text_field :endereco, class: "finput", placeholder: "Rua das Flores, 123" %>
    </div>
    <div class="fg">
      <%= form.label :cidade, "Cidade", class: "flabel" %>
      <%= form.text_field :cidade, class: "finput", placeholder: "São Paulo" %>
    </div>
  </div>

  <!-- Status e Observações -->
  <div class="card">
    <div class="card-lbl">Configurações</div>
    <div class="fg">
      <%= form.label :status, "Status *", class: "flabel" %>
      <%= form.select :status, 
          options_for_select([
            ["Ativo", 0], 
            ["Bloqueado", 1],
            ["Inativo", 2]
          ], @cliente.status || 0), 
          { required: true }, class: "fselect" %>
    </div>
    <div class="fg">
      <%= form.label :observacoes, "Observações", class: "flabel" %>
      <%= form.text_area :observacoes, class: "ftextarea", placeholder: "Observações sobre o cliente..." %>
    </div>
  </div>

  <!-- Botões -->
  <div class="btn-row">
    <%= link_to "Cancelar", clientes_path, class: "btn btn-ghost" %>
    <%= form.submit "Salvar Cliente", class: "btn btn-gold" %>
  </div>
<% end %>
