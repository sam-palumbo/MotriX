<% content_for :title, "Clientes | MotriX" %>

<div class="sec-head">
  <div>
    <div class="sec-title">Clientes</div>
    <div class="sec-sub"><%= @clientes.size %> clientes cadastrados</div>
  </div>
  <%= link_to "Novo Cliente", new_cliente_path, class: "btn btn-gold btn-sm" %>
</div>

<!-- Search/Filter -->
<div class="card">
  <div class="fg">
    <input type="text" class="finput" placeholder="🔍 Buscar cliente por nome, CPF ou telefone..." id="cliente-search">
  </div>
</div>

<div id="clientes-list">
  <% @clientes.each do |cliente| %>
    <div class="li" onclick="window.location.href='<%= cliente_path(cliente) %>'" data-search-text="<%= cliente.nome.downcase %> <%= cliente.cpf %> <%= cliente.telefone %> <%= cliente.email %>">
      <div class="li-icon" style="background:rgba(80,144,240,.1)">👤</div>
      <div class="li-body">
        <div class="li-title"><%= cliente.nome %></div>
        <div class="li-sub">
          <%= cliente.cpf.present? ? cliente.cpf.gsub(/(\d{3})(\d{3})(\d{3})(\d{2})/, '\1.\2.\3-\4') : "Sem CPF" %>
        </div>
        <div class="mt4">
          <% if cliente.telefone.present? %>
            <span class="badge b-blue">📱 <%= cliente.telefone %></span>
          <% end %>
          <% if cliente.cidade.present? %>
            <span class="badge b-gray">📍 <%= cliente.cidade %>/<%= cliente.estado %></span>
          <% end %>
        </div>
      </div>
      <div class="li-right">
        <span class="badge <%= cliente.status == 'ativo' ? 'b-green' : 'b-orange' %>">
          <%= enum_label(cliente.status) %>
        </span>
      </div>
    </div>
  <% end %>
  
  <% if @clientes.empty? %>
    <div class="empty">
      <div class="empty-ico">👥</div>
      <div style="font-size:13px">Nenhum cliente cadastrado</div>
    </div>
  <% end %>
</div>

<script>
document.getElementById('cliente-search').addEventListener('input', function(e) {
  const searchTerm = e.target.value.toLowerCase();
  const clientes = document.querySelectorAll('#clientes-list .li');
  
  clientes.forEach(cliente => {
    const searchText = cliente.dataset.searchText;
    if (searchText.includes(searchTerm)) {
      cliente.style.display = 'flex';
    } else {
      cliente.style.display = 'none';
    }
  });
});
</script>
