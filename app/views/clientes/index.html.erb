<% content_for :title, "Clientes | MotriX" %>

<section class="flex items-end justify-between gap-4">
  <div>
    <p class="text-sm font-medium uppercase tracking-[0.2em] text-teal-700">Clientes</p>
    <h2 class="mt-1 text-3xl font-semibold text-stone-950">Base de clientes</h2>
  </div>
  <div class="rounded-full bg-white px-4 py-2 text-sm font-medium text-stone-600 ring-1 ring-stone-200">
    <%= @clientes.size %> registros
  </div>
</section>

<section class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
  <% @clientes.each do |cliente| %>
    <article class="rounded-3xl border border-stone-200 bg-white p-5">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h3 class="text-lg font-semibold text-stone-950"><%= cliente.nome %></h3>
          <p class="mt-1 text-sm text-stone-500"><%= cliente.cpf %></p>
        </div>
        <span class="rounded-full px-3 py-1 text-xs font-semibold <%= badge_classes(cliente.status) %>"><%= enum_label(cliente.status) %></span>
      </div>
      <div class="mt-4 space-y-2 text-sm text-stone-600">
        <p><strong>Telefone:</strong> <%= cliente.telefone.presence || "-" %></p>
        <p><strong>Email:</strong> <%= cliente.email.presence || "-" %></p>
        <p><strong>Cidade:</strong> <%= [cliente.cidade, cliente.estado].compact.join(" / ").presence || "-" %></p>
        <p><strong>CNH:</strong> <%= cliente.cnh.presence || "-" %></p>
      </div>
    </article>
  <% end %>
</section>
