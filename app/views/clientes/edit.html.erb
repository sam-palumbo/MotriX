<div class="sec-head">
  <div>
    <div class="sec-title">Editar Cliente</div>
    <div class="sec-sub">Atualizar informações do cliente</div>
  </div>
</div>

<%= form_with(model: @cliente, local: true, class: "max-w-2xl") do |form| %>
  <% if @cliente.errors.any? %>
    <div class="alert a-red">
      <div class="a-icon">⚠</div>
      <div>
        <div class="a-title">Erros no formulário</div>
        <div class="a-sub">
          <% @cliente.errors.full_messages.each do |message| %>
            • <%= message %><br>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Dados Pessoais -->
  <div class="card">
    <div class="card-lbl">Dados Pessoais</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :nome, "Nome Completo", class: "flabel" %>
        <%= form.text_field :nome, class: "finput", placeholder: "Nome completo do cliente" %>
      </div>
      <div class="fg">
        <%= form.label :cpf, "CPF", class: "flabel" %>
        <%= form.text_field :cpf, class: "finput", placeholder: "000.000.000-00" %>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <%= form.label :telefone, "Telefone", class: "flabel" %>
        <%= form.text_field :telefone, class: "finput", placeholder: "(00) 00000-0000" %>
      </div>
      <div class="fg">
        <%= form.label :email, "Email", class: "flabel" %>
        <%= form.email_field :email, class: "finput", placeholder: "email@exemplo.com" %>
      </div>
    </div>
  </div>

  <!-- CNH -->
  <div class="card">
    <div class="card-lbl">CNH</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :cnh, "Número da CNH", class: "flabel" %>
        <%= form.text_field :cnh, class: "finput", placeholder: "00000000000" %>
      </div>
      <div class="fg">
        <%= form.label :validade_cnh, "Validade", class: "flabel" %>
        <%= form.date_field :validade_cnh, class: "finput" %>
      </div>
    </div>
  </div>

  <!-- Endereço -->
  <div class="card">
    <div class="card-lbl">Endereço</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :endereco, "Endereço", class: "flabel" %>
        <%= form.text_field :endereco, class: "finput", placeholder: "Rua, número, complemento" %>
      </div>
      <div class="fg">
        <%= form.label :cidade, "Cidade", class: "flabel" %>
        <%= form.text_field :cidade, class: "finput", placeholder: "Nome da cidade" %>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <%= form.label :estado, "Estado", class: "flabel" %>
        <%= form.text_field :estado, class: "finput", placeholder: "UF" %>
      </div>
      <div class="fg">
        <%= form.label :cep, "CEP", class: "flabel" %>
        <%= form.text_field :cep, class: "finput", placeholder: "00000-000" %>
      </div>
    </div>
  </div>

  <!-- Status e Observações -->
  <div class="card">
    <div class="card-lbl">Status e Observações</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :status, "Situação", class: "flabel" %>
        <%= form.select :status, 
            options_for_select([
              ["Ativo", "ativo"], 
              ["Bloqueado", "bloqueado"],
              ["Inativo", "inativo"]
            ], @cliente.status), 
            {}, class: "fselect" %>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <%= form.label :observacoes, "Observações", class: "flabel" %>
        <%= form.text_area :observacoes, class: "finput", rows: 3, placeholder: "Observações adicionais..." %>
      </div>
    </div>
  </div>

  <!-- Botões -->
  <div class="btn-row">
    <%= link_to "Cancelar", @cliente, class: "btn btn-ghost" %>
    <%= form.submit "Atualizar Cliente", class: "btn btn-gold" %>
  </div>
<% end %>
