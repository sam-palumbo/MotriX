<div class="sec-head">
  <div>
    <div class="sec-title">Novo Sócio</div>
    <div class="sec-sub">Adicionar sócio à frota</div>
  </div>
</div>

<%= form_with(model: @socio, local: true, class: "max-w-2xl") do |form| %>
  <% if @socio.errors.any? %>
    <div class="alert a-red">
      <div class="a-icon">⚠</div>
      <div>
        <div class="a-title">Erros no formulário</div>
        <div class="a-sub">
          <% @socio.errors.full_messages.each do |message| %>
            • <%= message %><br>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Dados Pessoais -->
  <div class="card">
    <div class="card-lbl">Dados Pessoais</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :nome, "Nome Completo", class: "flabel" %>
        <%= form.text_field :nome, class: "finput", placeholder: "Nome completo do sócio" %>
      </div>
      <div class="fg">
        <%= form.label :cpf, "CPF", class: "flabel" %>
        <%= form.text_field :cpf, class: "finput", placeholder: "000.000.000-00" %>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <%= form.label :telefone, "Telefone", class: "flabel" %>
        <%= form.text_field :telefone, class: "finput", placeholder: "(11) 99999-9999" %>
      </div>
      <div class="fg">
        <%= form.label :email, "Email", class: "flabel" %>
        <%= form.email_field :email, class: "finput", placeholder: "email@exemplo.com" %>
      </div>
    </div>
  </div>

  <!-- Informações Adicionais -->
  <div class="card">
    <div class="card-lbl">Informações Adicionais</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :endereco, "Endereço", class: "flabel" %>
        <%= form.text_field :endereco, class: "finput", placeholder: "Rua, número, bairro" %>
      </div>
      <div class="fg">
        <%= form.label :cidade, "Cidade", class: "flabel" %>
        <%= form.text_field :cidade, class: "finput", placeholder: "São Paulo" %>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <%= form.label :estado, "Estado", class: "flabel" %>
        <%= form.text_field :estado, class: "finput", placeholder: "SP" %>
      </div>
      <div class="fg">
        <%= form.label :cep, "CEP", class: "flabel" %>
        <%= form.text_field :cep, class: "finput", placeholder: "00000-000" %>
      </div>
    </div>
  </div>

  <!-- Observações -->
  <div class="card">
    <div class="card-lbl">Observações</div>
    <div class="fg">
      <%= form.label :observacoes, "Informações relevantes", class: "flabel" %>
      <%= form.text_area :observacoes, class: "ftextarea", placeholder: "Informações adicionais sobre o sócio..." %>
    </div>
  </div>

  <!-- Botões -->
  <div class="btn-row">
    <%= link_to "Cancelar", socios_path, class: "btn btn-ghost" %>
    <%= form.submit "Adicionar Sócio", class: "btn btn-gold" %>
  </div>
<% end %>
