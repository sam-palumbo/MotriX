<div class="sec-head">
  <div>
    <div class="sec-title">Editar Sócio</div>
    <div class="sec-sub">Atualizar informações do sócio</div>
  </div>
</div>

<%= form_with(model: @socio, local: true, class: "max-w-2xl") do |form| %>
  <% if @socio.errors.any? %>
    <div class="alert a-red">
      <div class="a-icon">⚠</div>
      <div>
        <div class="a-title">Erros no formulário</div>
        <div class="a-sub">
          <% @socio.errors.full_messages.each do |message| %>
            • <%= message %><br>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Dados Pessoais -->
  <div class="card">
    <div class="card-lbl">Dados Pessoais</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :nome, "Nome Completo", class: "flabel" %>
        <%= form.text_field :nome, class: "finput", placeholder: "Nome completo do sócio" %>
      </div>
      <div class="fg">
        <%= form.label :cpf, "CPF", class: "flabel" %>
        <%= form.text_field :cpf, class: "finput", placeholder: "000.000.000-00" %>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <%= form.label :telefone, "Telefone", class: "flabel" %>
        <%= form.text_field :telefone, class: "finput", placeholder: "(00) 00000-0000" %>
      </div>
      <div class="fg">
        <%= form.label :email, "Email", class: "flabel" %>
        <%= form.email_field :email, class: "finput", placeholder: "email@exemplo.com" %>
      </div>
    </div>
  </div>

  <!-- Botões -->
  <div class="btn-row">
    <%= link_to "Cancelar", @socio, class: "btn btn-ghost" %>
    <%= form.submit "Atualizar Sócio", class: "btn btn-gold" %>
  </div>
<% end %>
