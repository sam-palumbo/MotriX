<div class="sec-head">
  <div>
    <div class="sec-title">Detalhes do Sócio</div>
    <div class="sec-sub">Informações do sócio</div>
  </div>
  <div class="btn-row">
    <%= link_to "Editar", edit_socio_path(@socio), class: "btn btn-ghost" %>
    <%= link_to "Voltar", socios_path, class: "btn btn-ghost" %>
  </div>
</div>

<!-- Informações Pessoais -->
<div class="card">
  <div class="card-lbl">Informações Pessoais</div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Nome</div>
      <div class="fvalue"><%= @socio.nome %></div>
    </div>
    <div class="fg">
      <div class="flabel">CPF</div>
      <div class="fvalue"><%= @socio.cpf %></div>
    </div>
  </div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Telefone</div>
      <div class="fvalue"><%= @socio.telefone %></div>
    </div>
    <div class="fg">
      <div class="flabel">Email</div>
      <div class="fvalue"><%= @socio.email %></div>
    </div>
  </div>
</div>

<!-- Resumo de Participações -->
<div class="card">
  <div class="card-lbl">Resumo de Participações</div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Total de Veículos</div>
      <div class="fvalue"><%= @socio.participacao_socios.count %></div>
    </div>
    <div class="fg">
      <div class="flabel">Total Investido</div>
      <div class="fvalue">R$ <%= number_to_currency(@socio.participacao_socios.sum(:valor_investido), unit: "", separator: ",", delimiter: ".") %></div>
    </div>
  </div>
</div>

<% if @socio.participacao_socios.any? %>
<!-- Participações na Frota -->
<div class="card">
  <div class="card-lbl">Participações na Frota</div>
  <div class="frow">
    <div class="fg">
      <% @socio.participacao_socios.each do |participacao| %>
        <div class="card" style="margin-bottom: 12px; background: var(--gray-50);">
          <div class="frow">
            <div class="fg">
              <div class="fvalue">
                <div><%= participacao.veiculo.placa %> - <%= participacao.veiculo.modelo %></div>
                <div class="text-sm text-gray-600"><%= participacao.veiculo.marca %> <%= participacao.veiculo.ano %></div>
              </div>
            </div>
            <div class="fg">
              <div class="fvalue text-right">
                <div><%= participacao.percentual_participacao.to_f %>%</div>
                <div class="text-sm text-gray-600">R$ <%= number_to_currency(participacao.valor_investido, unit: "", separator: ",", delimiter: ".") %></div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>
