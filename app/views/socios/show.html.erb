<div class="max-w-4xl mx-auto">
  <div class="bg-white shadow-sm rounded-lg">
    <div class="px-6 py-4 border-b border-gray-200">
      <div class="flex items-center justify-between">
        <h1 class="text-xl font-semibold text-gray-900">Detalhes do Sócio</h1>
        <div class="flex space-x-2">
          <%= link_to "Editar", edit_socio_path(@socio), class: "px-3 py-1 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          <%= link_to "Voltar", socios_path, class: "px-3 py-1 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        </div>
      </div>
    </div>
    
    <div class="px-6 py-4">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="space-y-4">
          <div>
            <h3 class="text-sm font-medium text-gray-500">Informações Pessoais</h3>
            <div class="mt-2 space-y-2">
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Nome:</span>
                <span class="text-sm font-medium text-gray-900"><%= @socio.nome %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">CPF:</span>
                <span class="text-sm font-medium text-gray-900"><%= @socio.cpf %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Telefone:</span>
                <span class="text-sm font-medium text-gray-900"><%= @socio.telefone %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Email:</span>
                <span class="text-sm font-medium text-gray-900"><%= @socio.email %></span>
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-4">
          <div>
            <h3 class="text-sm font-medium text-gray-500">Resumo de Participações</h3>
            <div class="mt-2 space-y-2">
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Total de Veículos:</span>
                <span class="text-sm font-medium text-gray-900"><%= @socio.participacao_socios.count %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Total Investido:</span>
                <span class="text-sm font-medium text-gray-900">R$ <%= number_to_currency(@socio.participacao_socios.sum(:valor_investido), unit: "", separator: ",", delimiter: ".") %></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <% if @socio.participacao_socios.any? %>
        <div class="mt-6">
          <h3 class="text-sm font-medium text-gray-500">Participações na Frota</h3>
          <div class="mt-2 space-y-3">
            <% @socio.participacao_socios.each do |participacao| %>
              <div class="rounded-lg border border-gray-200 p-4">
                <div class="flex items-center justify-between">
                  <div>
                    <h4 class="text-sm font-medium text-gray-900"><%= participacao.veiculo.placa %> - <%= participacao.veiculo.modelo %></h4>
                    <p class="text-sm text-gray-600"><%= participacao.veiculo.marca %> <%= participacao.veiculo.ano %></p>
                  </div>
                  <div class="text-right">
                    <p class="text-sm font-medium text-gray-900"><%= participacao.percentual_participacao.to_f %>%</p>
                    <p class="text-sm text-gray-600">R$ <%= number_to_currency(participacao.valor_investido, unit: "", separator: ",", delimiter: ".") %></p>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="mt-6 pt-6 border-t border-gray-200">
        <div class="flex justify-between items-center text-sm text-gray-500">
          <div>
            Criado em: <%= @socio.created_at.strftime("%d/%m/%Y %H:%M") %>
          </div>
          <div>
            Atualizado em: <%= @socio.updated_at.strftime("%d/%m/%Y %H:%M") %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
