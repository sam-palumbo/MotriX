<% content_for :title, "Socios | MotriX" %>

<section class="flex items-end justify-between gap-4">
  <div>
    <p class="text-sm font-medium uppercase tracking-[0.2em] text-teal-700">Socios</p>
    <h2 class="mt-1 text-3xl font-semibold text-stone-950">Participacoes na frota</h2>
  </div>
  <div class="flex items-center gap-3">
    <div class="rounded-full bg-white px-4 py-2 text-sm font-medium text-stone-600 ring-1 ring-stone-200">
      <%= @socios.size %> socios
    </div>
    <%= link_to "Novo Sócio", new_socio_path, class: "rounded-full bg-teal-700 px-4 py-2 text-sm font-medium text-white hover:bg-teal-800 transition-colors" %>
  </div>
</section>

<section class="mt-6 grid gap-4 lg:grid-cols-2">
  <% @socios.each do |socio| %>
    <article class="rounded-3xl border border-stone-200 bg-white p-5">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h3 class="text-lg font-semibold text-stone-950"><%= socio.nome %></h3>
          <p class="mt-1 text-sm text-stone-500"><%= socio.cpf %></p>
        </div>
      </div>

      <div class="mt-4 space-y-3">
        <% socio.participacao_socios.each do |participacao| %>
          <div class="rounded-2xl bg-stone-100 p-4 text-sm text-stone-700">
            <div class="flex items-center justify-between gap-3">
              <span class="font-medium text-stone-950"><%= participacao.veiculo.placa %></span>
              <span><%= participacao.percentual_participacao.to_f %>%</span>
            </div>
            <p class="mt-2">Investimento: <strong><%= brl(participacao.valor_investido) %></strong></p>
          </div>
        <% end %>
      </div>
    </article>
  <% end %>
</section>
