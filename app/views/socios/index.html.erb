<% content_for :title, "Sócios | MotriX" %>

<div class="sec-head">
  <div>
    <div class="sec-title">Sócios</div>
    <div class="sec-sub"><%= @socios.size %> sócios na frota</div>
  </div>
  <%= link_to "Novo Sócio", "#", onclick: "AppModal.load('#{new_socio_path}', 'Novo Sócio', 'Adicionar sócio à frota'); return false;", class: "btn btn-gold btn-sm" %>
</div>

<!-- Quick Stats -->
<div class="kgrid">
  <div class="kcard">
    <div class="knum" style="color:var(--gold)">
      <%= @socios.count %>
    </div>
    <div class="kdesc">Sócios</div>
  </div>
  <div class="kcard">
    <div class="knum" style="font-size:20px">
      <%= @socios.joins(:participacao_socios).distinct.count %>
    </div>
    <div class="kdesc">Com participações</div>
  </div>
  <div class="kcard">
    <div class="knum" style="color:var(--green)">
      <%= brl(ParticipacaoSocio.sum(:valor_investido)) %>
    </div>
    <div class="kdesc">Total investido</div>
  </div>
  <div class="kcard">
    <div class="knum" style="font-size:20px">
      <%= ParticipacaoSocio.sum(:percentual_participacao).to_f %>%
    </div>
    <div class="kdesc">Participação total</div>
  </div>
</div>

<div id="socios-list">
  <% @socios.each do |socio| %>
    <div class="vcard" onclick="window.location.href='<%= socio_path(socio) %>'">
      <div class="vc-head">
        <div class="vc-plate" style="background:var(--gold)">
          👤
        </div>
        <div class="flex1" style="padding-left:4px">
          <div style="font-size:14px;font-weight:600;line-height:1.4">
            <%= socio.nome %>
          </div>
          <div style="margin-top:4px">
            <span class="badge b-gray">
              <%= socio.cpf.present? ? socio.cpf.gsub(/(\d{3})(\d{3})(\d{3})(\d{2})/, '\1.\2.\3-\4') : "Sem CPF" %>
            </span>
          </div>
        </div>
      </div>
      <div class="vc-body">
        <% if socio.participacao_socios.any? %>
          <div class="vc-stats">
            <% socio.participacao_socios.limit(3).each do |participacao| %>
              <div class="vc-stat">
                <div class="vc-sn" style="font-size:11px"><%= participacao.veiculo.placa %></div>
                <div class="vc-sl"><%= participacao.percentual_participacao.to_f %>%</div>
              </div>
            <% end %>
            <% if socio.participacao_socios.count > 3 %>
              <div class="vc-stat">
                <div class="vc-sn" style="font-size:10px">+<%= socio.participacao_socios.count - 3 %></div>
                <div class="vc-sl">mais</div>
              </div>
            <% end %>
          </div>
          
          <div class="vc-client">
            <span style="color:var(--text3)">Investimento</span>
            <span style="font-weight:600">
              <%= brl(socio.participacao_socios.sum(:valor_investido)) %> • <%= socio.participacao_socios.sum(:percentual_participacao).to_f %>%
            </span>
          </div>
        <% else %>
          <div class="vc-client">
            <span style="color:var(--text3)">Participações</span>
            <span style="font-weight:600">Nenhuma participacao registrada</span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
  
  <% if @socios.empty? %>
    <div class="empty">
      <div class="empty-ico">👥</div>
      <div style="font-size:13px">Nenhum sócio cadastrado</div>
    </div>
  <% end %>
</div>
