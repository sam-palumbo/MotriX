<div class="sec-head">
  <div>
    <div class="sec-title">Editar Veículo</div>
    <div class="sec-sub">Atualizar dados da moto</div>
  </div>
</div>

<%= form_with(model: @veiculo, local: true, class: "max-w-2xl") do |form| %>
  <% if @veiculo.errors.any? %>
    <div class="alert a-red">
      <div class="a-icon">⚠</div>
      <div>
        <div class="a-title">Erros no formulário</div>
        <div class="a-sub">
          <% @veiculo.errors.full_messages.each do |message| %>
            • <%= message %><br>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Identificação -->
  <div class="card">
    <div class="card-lbl">Identificação</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :placa, "Placa", class: "flabel" %>
        <%= form.text_field :placa, class: "finput", style: "text-transform:uppercase" %>
      </div>
      <div class="fg">
        <%= form.label :renavam, "RENAVAM", class: "flabel" %>
        <%= form.text_field :renavam, class: "finput" %>
      </div>
    </div>
    <div class="fg">
      <%= form.label :chassi, "Chassi", class: "flabel" %>
      <%= form.text_field :chassi, class: "finput" %>
    </div>
  </div>

  <!-- Detalhes -->
  <div class="card">
    <div class="card-lbl">Detalhes do Veículo</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :marca, "Marca", class: "flabel" %>
        <%= form.text_field :marca, class: "finput" %>
      </div>
      <div class="fg">
        <%= form.label :modelo, "Modelo", class: "flabel" %>
        <%= form.text_field :modelo, class: "finput" %>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <%= form.label :ano, "Ano", class: "flabel" %>
        <%= form.number_field :ano, class: "finput" %>
      </div>
      <div class="fg">
        <%= form.label :cor, "Cor", class: "flabel" %>
        <%= form.text_field :cor, class: "finput" %>
      </div>
    </div>
    <div class="fg">
      <%= form.label :status, "Status", class: "flabel" %>
      <%= form.select :status, 
          options_for_select([
            ["Disponível", 0], 
            ["Locado", 1], 
            ["Em Manutenção", 2], 
            ["Inativo", 3]
          ], @veiculo.status), 
          {}, class: "fselect" %>
    </div>
  </div>

  <!-- Datas -->
  <div class="card">
    <div class="card-lbl">Datas</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :data_compra, "Data Compra", class: "flabel" %>
        <%= form.date_field :data_compra, class: "finput" %>
      </div>
      <div class="fg">
        <%= form.label :primeira_locacao_em, "Primeira Locação", class: "flabel" %>
        <%= form.date_field :primeira_locacao_em, class: "finput" %>
      </div>
    </div>
  </div>

  <!-- Valores -->
  <div class="card">
    <div class="card-lbl">Valores Financeiros</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :valor_compra, "Valor Compra (R$)", class: "flabel" %>
        <%= form.number_field :valor_compra, step: 0.01, class: "finput" %>
      </div>
      <div class="fg">
        <%= form.label :valor_aquisicao, "Valor Aquisição (R$)", class: "flabel" %>
        <%= form.number_field :valor_aquisicao, step: 0.01, class: "finput" %>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <%= form.label :valor_semanal, "Valor Semanal (R$)", class: "flabel" %>
        <%= form.number_field :valor_semanal, step: 0.01, class: "finput" %>
      </div>
      <div class="fg">
        <%= form.label :valor_diaria, "Valor Diária (R$)", class: "flabel" %>
        <%= form.number_field :valor_diaria, step: 0.01, class: "finput" %>
      </div>
    </div>
    <div class="fg">
      <%= form.label :caucao_retida, "Caução Retida (R$)", class: "flabel" %>
      <%= form.number_field :caucao_retida, step: 0.01, class: "finput" %>
    </div>
  </div>

  <!-- Quilometragem -->
  <div class="card">
    <div class="card-lbl">Quilometragem</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :km_aquisicao, "KM Aquisição", class: "flabel" %>
        <%= form.number_field :km_aquisicao, class: "finput" %>
      </div>
      <div class="fg">
        <%= form.label :km_atual, "KM Atual", class: "flabel" %>
        <%= form.number_field :km_atual, class: "finput" %>
      </div>
    </div>
  </div>

  <!-- Botões -->
  <div class="btn-row">
    <%= link_to "Cancelar", @veiculo, class: "btn btn-ghost" %>
    <%= form.submit "Atualizar Veículo", class: "btn btn-gold" %>
  </div>
<% end %>
