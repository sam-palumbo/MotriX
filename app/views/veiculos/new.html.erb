<div class="max-w-2xl mx-auto">
  <div class="bg-white shadow-sm rounded-lg">
    <div class="px-6 py-4 border-b border-gray-200">
      <h1 class="text-xl font-semibold text-gray-900">Novo Veículo</h1>
    </div>
    
    <div class="px-6 py-4">
      <%= form_with(model: @veiculo, local: true, class: "space-y-6") do |form| %>
        <% if @veiculo.errors.any? %>
          <div class="rounded-md bg-red-50 p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  <%= pluralize(@veiculo.errors.count, "error") %> prohibited this veiculo from being saved:
                </h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul class="list-disc list-inside">
                    <% @veiculo.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <%= form.label :placa, "Placa", class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_field :placa, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :renavam, "RENAVAM", class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_field :renavam, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :chassi, "Chassi", class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_field :chassi, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :marca, "Marca", class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_field :marca, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :modelo, "Modelo", class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_field :modelo, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :ano, "Ano", class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :ano, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :cor, "Cor", class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_field :cor, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :status, "Status", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :status, options_for_select([["Disponível", 0], ["Locado", 1], ["Em Manutenção", 2], ["Inativo", 3]], @veiculo.status), {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <%= form.label :data_compra, "Data Compra", class: "block text-sm font-medium text-gray-700" %>
            <%= form.date_field :data_compra, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :primeira_locacao_em, "Primeira Locação", class: "block text-sm font-medium text-gray-700" %>
            <%= form.date_field :primeira_locacao_em, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <%= form.label :valor_compra, "Valor Compra", class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :valor_compra, step: 0.01, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :valor_aquisicao, "Valor Aquisição", class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :valor_aquisicao, step: 0.01, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :valor_semanal, "Valor Semanal", class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :valor_semanal, step: 0.01, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :valor_diaria, "Valor Diária", class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :valor_diaria, step: 0.01, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :caucao_retida, "Caução Retida", class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :caucao_retida, step: 0.01, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <%= form.label :km_aquisicao, "KM Aquisição", class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :km_aquisicao, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :km_atual, "KM Atual", class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :km_atual, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>
        </div>

        <div class="flex justify-end space-x-3">
          <%= link_to "Cancelar", veiculos_path, class: "px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          <%= form.submit "Salvar Veículo", class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
