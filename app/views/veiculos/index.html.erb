<% content_for :title, "Veiculos | MotriX" %>

<section class="flex items-end justify-between gap-4">
  <div>
    <p class="text-sm font-medium uppercase tracking-[0.2em] text-teal-700">Frota</p>
    <h2 class="mt-1 text-3xl font-semibold text-stone-950">Veiculos</h2>
  </div>
  <div class="rounded-full bg-white px-4 py-2 text-sm font-medium text-stone-600 ring-1 ring-stone-200">
    <%= @veiculos.size %> veiculos
  </div>
</section>

<section class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
  <% @veiculos.each do |veiculo| %>
    <article class="rounded-3xl border border-stone-200 bg-white p-5">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h3 class="text-lg font-semibold text-stone-950"><%= veiculo.placa %></h3>
          <p class="mt-1 text-sm text-stone-500"><%= [veiculo.marca, veiculo.modelo, veiculo.ano].compact.join(" • ") %></p>
        </div>
        <span class="rounded-full px-3 py-1 text-xs font-semibold <%= badge_classes(veiculo.status) %>"><%= enum_label(veiculo.status) %></span>
      </div>
      <div class="mt-4 grid grid-cols-2 gap-3 text-sm text-stone-600">
        <p><strong>Renavam:</strong> <%= veiculo.renavam %></p>
        <p><strong>Chassi:</strong> <%= veiculo.chassi %></p>
        <p><strong>Semanal:</strong> <%= brl(veiculo.valor_semanal) %></p>
        <p><strong>Diaria:</strong> <%= brl(veiculo.valor_diaria) %></p>
        <p><strong>KM atual:</strong> <%= veiculo.km_atual || "-" %></p>
        <p><strong>Caucao:</strong> <%= brl(veiculo.caucao_retida) %></p>
      </div>
    </article>
  <% end %>
</section>
