<% content_for :title, "Frota | MotriX" %>

<div class="sec-head">
  <div>
    <div class="sec-title">Frota</div>
    <div class="sec-sub"><%= @veiculos.size %> veículos cadastrados</div>
  </div>
  <%= link_to "Novo Veículo", "#", onclick: "AppModal.load('#{new_veiculo_path}', 'Novo Veículo', 'Adicionar moto à frota'); return false;", class: "btn btn-gold btn-sm" %>
</div>

<!-- Tabs -->
<div class="tabs">
  <button class="tab active" onclick="filterVeiculos('todos', this)">Todos</button>
  <button class="tab" onclick="filterVeiculos('disponivel', this)">Disponíveis</button>
  <button class="tab" onclick="filterVeiculos('locado', this)">Locados</button>
  <button class="tab" onclick="filterVeiculos('manutencao', this)">Manutenção</button>
</div>

<div id="veiculos-list">
  <% @veiculos.each do |veiculo| %>
    <div class="vcard" data-status="<%= veiculo.status %>" onclick="AppModal.load('<%= veiculo_path(veiculo) %>', 'Detalhes do Veículo', 'Visualizar informações completas do veículo')">
      <div class="vc-head">
        <div class="vc-plate"><%= veiculo.placa %></div>
        <div class="flex1" style="padding-left:4px">
          <div style="font-size:12px;font-weight:600;line-height:1.4"><%= veiculo.marca %> <%= veiculo.modelo %> <%= veiculo.ano %></div>
          <div style="margin-top:4px;display:flex;gap:5px;flex-wrap:wrap">
            <span class="badge <%= veiculo.status == 'disponivel' ? 'b-green' : veiculo.status == 'locado' ? 'b-blue' : 'b-orange' %>">
              <%= enum_label(veiculo.status) %>
            </span>
          </div>
        </div>
      </div>
      <div class="vc-body">
        <div class="vc-stats">
          <div class="vc-stat">
            <div class="vc-sn"><%= veiculo.km_atual || 0 %></div>
            <div class="vc-sl">KM atual</div>
          </div>
          <div class="vc-stat">
            <div class="vc-sn" style="font-size:11px"><%= brl(veiculo.valor_semanal) %></div>
            <div class="vc-sl">/semana</div>
          </div>
          <div class="vc-stat">
            <div class="vc-sn" style="color:var(--gold)"><%= brl(veiculo.valor_diaria) %></div>
            <div class="vc-sl">/diária</div>
          </div>
        </div>
        
        <% if veiculo.locacoes.where(status: 'ativa').any? %>
          <% locacao_ativa = veiculo.locacoes.where(status: 'ativa').first %>
          <div class="vc-client">
            <span style="color:var(--text3)">Locatário</span>
            <span style="font-weight:600"><%= locacao_ativa.cliente.nome %></span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
  
  <% if @veiculos.empty? %>
    <div class="empty">
      <div class="empty-ico">🏍️</div>
      <div style="font-size:13px">Nenhum veículo cadastrado</div>
    </div>
  <% end %>
</div>

<script>
function filterVeiculos(status, element) {
  // Update active tab
  document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('active'));
  element.classList.add('active');
  
  // Filter vehicles
  const veiculos = document.querySelectorAll('.vcard');
  veiculos.forEach(veiculo => {
    if (status === 'todos') {
      veiculo.style.display = 'block';
    } else {
      veiculo.style.display = veiculo.dataset.status === status ? 'block' : 'none';
    }
  });
}
</script>
