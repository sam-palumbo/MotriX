<div class="max-w-4xl mx-auto">
  <div class="bg-white shadow-sm rounded-lg">
    <div class="px-6 py-4 border-b border-gray-200">
      <div class="flex items-center justify-between">
        <h1 class="text-xl font-semibold text-gray-900">Detalhes do Veículo</h1>
        <div class="flex space-x-2">
          <%= link_to "Editar", edit_veiculo_path(@veiculo), class: "px-3 py-1 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          <%= link_to "Voltar", veiculos_path, class: "px-3 py-1 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        </div>
      </div>
    </div>
    
    <div class="px-6 py-4">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="space-y-4">
          <div>
            <h3 class="text-sm font-medium text-gray-500">Informações Básicas</h3>
            <div class="mt-2 space-y-2">
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Placa:</span>
                <span class="text-sm font-medium text-gray-900"><%= @veiculo.placa %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">RENAVAM:</span>
                <span class="text-sm font-medium text-gray-900"><%= @veiculo.renavam %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Chassi:</span>
                <span class="text-sm font-medium text-gray-900"><%= @veiculo.chassi %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Marca:</span>
                <span class="text-sm font-medium text-gray-900"><%= @veiculo.marca %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Modelo:</span>
                <span class="text-sm font-medium text-gray-900"><%= @veiculo.modelo %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Ano:</span>
                <span class="text-sm font-medium text-gray-900"><%= @veiculo.ano %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Cor:</span>
                <span class="text-sm font-medium text-gray-900"><%= @veiculo.cor %></span>
              </div>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-medium text-gray-500">Quilometragem</h3>
            <div class="mt-2 space-y-2">
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">KM Aquisição:</span>
                <span class="text-sm font-medium text-gray-900"><%= @veiculo.km_aquisicao %> km</span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">KM Atual:</span>
                <span class="text-sm font-medium text-gray-900"><%= @veiculo.km_atual %> km</span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">KM Rodados:</span>
                <span class="text-sm font-medium text-gray-900"><%= @veiculo.km_atual - @veiculo.km_aquisicao %> km</span>
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-4">
          <div>
            <h3 class="text-sm font-medium text-gray-500">Valores</h3>
            <div class="mt-2 space-y-2">
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Valor Compra:</span>
                <span class="text-sm font-medium text-gray-900">R$ <%= number_to_currency(@veiculo.valor_compra, unit: "", separator: ",", delimiter: ".") %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Valor Aquisição:</span>
                <span class="text-sm font-medium text-gray-900">R$ <%= number_to_currency(@veiculo.valor_aquisicao, unit: "", separator: ",", delimiter: ".") %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Valor Semanal:</span>
                <span class="text-sm font-medium text-gray-900">R$ <%= number_to_currency(@veiculo.valor_semanal, unit: "", separator: ",", delimiter: ".") %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Valor Diária:</span>
                <span class="text-sm font-medium text-gray-900">R$ <%= number_to_currency(@veiculo.valor_diaria, unit: "", separator: ",", delimiter: ".") %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Caução Retida:</span>
                <span class="text-sm font-medium text-gray-900">R$ <%= number_to_currency(@veiculo.caucao_retida, unit: "", separator: ",", delimiter: ".") %></span>
              </div>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-medium text-gray-500">Datas</h3>
            <div class="mt-2 space-y-2">
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Data Compra:</span>
                <span class="text-sm font-medium text-gray-900"><%= @veiculo.data_compra&.strftime("%d/%m/%Y") %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Primeira Locação:</span>
                <span class="text-sm font-medium text-gray-900"><%= @veiculo.primeira_locacao_em&.strftime("%d/%m/%Y") || "Não locado" %></span>
              </div>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-medium text-gray-500">Status</h3>
            <div class="mt-2">
              <span class="px-2 py-1 text-xs font-medium rounded-full 
                <%= case @veiculo.status 
                    when 0 then 'bg-green-100 text-green-800'
                    when 1 then 'bg-blue-100 text-blue-800'
                    when 2 then 'bg-yellow-100 text-yellow-800'
                    when 3 then 'bg-red-100 text-red-800'
                    end %>">
                <%= @veiculo.status_text %>
              </span>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-6 pt-6 border-t border-gray-200">
        <div class="flex justify-between items-center text-sm text-gray-500">
          <div>
            Criado em: <%= @veiculo.created_at.strftime("%d/%m/%Y %H:%M") %>
          </div>
          <div>
            Atualizado em: <%= @veiculo.updated_at.strftime("%d/%m/%Y %H:%M") %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
