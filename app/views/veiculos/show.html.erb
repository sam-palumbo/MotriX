<div class="sec-head">
  <div>
    <div class="sec-title">Detalhes do Veículo</div>
    <div class="sec-sub">Informações do veículo</div>
  </div>
  <div class="btn-row">
    <%= link_to "Editar", edit_veiculo_path(@veiculo), class: "btn btn-ghost" %>
    <%= link_to "Voltar", veiculos_path, class: "btn btn-ghost" %>
  </div>
</div>

<!-- Informações Básicas -->
<div class="card">
  <div class="card-lbl">Informações Básicas</div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Placa</div>
      <div class="fvalue"><%= @veiculo.placa %></div>
    </div>
    <div class="fg">
      <div class="flabel">RENAVAM</div>
      <div class="fvalue"><%= @veiculo.renavam %></div>
    </div>
  </div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Chassi</div>
      <div class="fvalue"><%= @veiculo.chassi %></div>
    </div>
    <div class="fg">
      <div class="flabel">Marca</div>
      <div class="fvalue"><%= @veiculo.marca %></div>
    </div>
  </div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Modelo</div>
      <div class="fvalue"><%= @veiculo.modelo %></div>
    </div>
    <div class="fg">
      <div class="flabel">Ano</div>
      <div class="fvalue"><%= @veiculo.ano %></div>
    </div>
  </div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Cor</div>
      <div class="fvalue"><%= @veiculo.cor %></div>
    </div>
  </div>
</div>

<!-- Quilometragem -->
<div class="card">
  <div class="card-lbl">Quilometragem</div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">KM Aquisição</div>
      <div class="fvalue"><%= @veiculo.km_aquisicao %> km</div>
    </div>
    <div class="fg">
      <div class="flabel">KM Atual</div>
      <div class="fvalue"><%= @veiculo.km_atual %> km</div>
    </div>
  </div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">KM Rodados</div>
      <div class="fvalue"><%= @veiculo.km_atual - @veiculo.km_aquisicao %> km</div>
    </div>
  </div>
</div>

<!-- Valores -->
<div class="card">
  <div class="card-lbl">Valores</div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Valor Compra</div>
      <div class="fvalue">R$ <%= number_to_currency(@veiculo.valor_compra, unit: "", separator: ",", delimiter: ".") %></div>
    </div>
    <div class="fg">
      <div class="flabel">Valor Aquisição</div>
      <div class="fvalue">R$ <%= number_to_currency(@veiculo.valor_aquisicao, unit: "", separator: ",", delimiter: ".") %></div>
    </div>
  </div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Valor Semanal</div>
      <div class="fvalue">R$ <%= number_to_currency(@veiculo.valor_semanal, unit: "", separator: ",", delimiter: ".") %></div>
    </div>
    <div class="fg">
      <div class="flabel">Valor Diária</div>
      <div class="fvalue">R$ <%= number_to_currency(@veiculo.valor_diaria, unit: "", separator: ",", delimiter: ".") %></div>
    </div>
  </div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Caução Retida</div>
      <div class="fvalue">R$ <%= number_to_currency(@veiculo.caucao_retida, unit: "", separator: ",", delimiter: ".") %></div>
    </div>
  </div>
</div>

<!-- Datas -->
<div class="card">
  <div class="card-lbl">Datas</div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Data Compra</div>
      <div class="fvalue"><%= @veiculo.data_compra&.strftime("%d/%m/%Y") %></div>
    </div>
    <div class="fg">
      <div class="flabel">Primeira Locação</div>
      <div class="fvalue"><%= @veiculo.primeira_locacao_em&.strftime("%d/%m/%Y") || "Não locado" %></div>
    </div>
  </div>
</div>

<!-- Status -->
<div class="card">
  <div class="card-lbl">Status</div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Situação</div>
      <div class="flex items-center gap-2">
        <span class="badge 
          <%= case @veiculo.status 
              when 0 then 'b-green'
              when 1 then 'b-blue'
              when 2 then 'b-yellow'
              when 3 then 'b-red'
              end %>">
          <%= @veiculo.status_text %>
        </span>
      </div>
    </div>
  </div>
</div>
