<%# New Maintenance Form %>
<div class="sec-head">
  <div>
    <div class="sec-title">Registrar Manutenção</div>
    <div class="sec-sub">Adicionar nova manutenção para o veículo</div>
  </div>
  <div class="btn-row">
    <%= link_to "Voltar", veiculos_path, class: "btn btn-ghost" %>
  </div>
</div>

<div class="card">
  <% @veiculo = Veiculo.find(@veiculo_id) %>
  <%= form_tag(manutencao_veiculo_path(@veiculo), method: :post) do %>
    <%= hidden_field_tag :veiculo_id, @veiculo_id %>
    
    <div class="card-lbl">Tipo de Manutenção</div>
    <div class="fg">
      <select name="tipo_manutencao" class="fselect" required>
        <option value="">Selecione...</option>
        <option value="troca_oleo">Troca de Óleo</option>
        <option value="pneu">Pneu</option>
        <option value="freio">Freio</option>
        <option value="corrente">Corrente</option>
        <option value="revisao">Revisão</option>
        <option value="outros">Outros</option>
      </select>
    </div>
  </div>

  <div class="card">
    <div class="card-lbl">Detalhes</div>
    <div class="frow">
      <div class="fg">
        <label class="flabel">Valor (R$)</label>
        <input type="number" name="valor" class="finput" step="0.01" min="0" required>
      </div>
      <div class="fg">
        <label class="flabel">Quilometragem</label>
        <input type="number" name="quilometragem" class="finput" value="<%= @veiculo.km_atual %>" required>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <label class="flabel">Data</label>
        <input type="date" name="data_evento" class="finput" value="<%= Date.current %>" required>
      </div>
      <input type="hidden" name="responsavel" value="<%= Current.usuario&.nome %>">
    </div>
    <div class="fg">
      <label class="flabel">Descrição</label>
      <textarea name="descricao" class="finput" rows="3" placeholder="Detalhes da manutenção..." required></textarea>
    </div>
  </div>

  <!-- Botões -->
  <div class="btn-row">
    <%= link_to "Cancelar", veiculos_path, class: "btn btn-ghost" %>
    <button type="submit" class="btn btn-gold">Registrar Manutenção</button>
  </div>
<% end %>
