<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= content_for(:title) || "MotriX" %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= yield :head %>

  <link rel="icon" href="<%= asset_path 'favicon.svg' %>" type="image/svg+xml">
  <link rel="icon" href="<%= asset_path 'logo.svg' %>" type="image/svg+xml">
  <link rel="apple-touch-icon" href="<%= asset_path 'logo.svg' %>">

  <%= stylesheet_link_tag "dark_theme", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>

<body>
  <% if Current.usuario %>
    <div class="shell">
      <!-- TOPBAR -->
    <div class="topbar">
      <div class="t-logo">
        <%= image_tag "logo.svg", alt: "MotriX Logo", style: "height:40px;width:auto;margin-right:12px" %>
        <div>
          <div class="t-name">MotriX</div>
          <div class="t-sub">Gestão de Frota</div>
        </div>
      </div>
      <div style="text-align:right">
        <div class="t-date" id="tDate"></div>
        <div class="flex items-center gap-3 justify-end mt-1">
          <div id="t-user" style="font-size:10px;color:var(--green);font-family:'DM Mono',monospace">
            ● <%= Current.usuario&.nome || "Sem usuário ativo" %>
          </div>
          <%= button_to "Sair", logout_path, method: :delete, class: "text-[10px] text-stone-400 hover:text-white underline" %>
        </div>
      </div>
    </div>

    <div class="scroller">
      <% flash.each do |type, message| %>
        <div class="alert a-<%= flash_alert_class(type) %>">
          <div class="a-icon"><%= flash_icon(type) %></div>
          <div>
            <div class="a-title"><%= flash_title(type) %></div>
            <div class="a-sub"><%= message %></div>
          </div>
        </div>
      <% end %>

      <%= yield %>
    </div>

    <!-- MODAL COMPONENT -->
    <%= render 'shared/modal' %>

    <!-- BOTTOM NAV -->
    <nav class="nav">
      <a href="<%= root_path %>" class="ni <%= current_page?(root_path) ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="3" y="3" width="7" height="9" rx="1.5"/>
          <rect x="14" y="3" width="7" height="5" rx="1.5"/>
          <rect x="14" y="12" width="7" height="9" rx="1.5"/>
          <rect x="3" y="16" width="7" height="5" rx="1.5"/>
        </svg>
        <span class="ni-lbl">Início</span>
      </a>
      <a href="<%= veiculos_path %>" class="ni <%= current_page?(veiculos_path) ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="12" cy="12" r="9"/>
          <path d="M12 7v5l3.5 2"/>
        </svg>
        <span class="ni-lbl">Frota</span>
      </a>
      <a href="<%= locacoes_path %>" class="ni <%= current_page?(locacoes_path) ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="12" cy="12" r="9"/>
          <path d="M12 8v8M8 12h8"/>
        </svg>
        <span class="ni-lbl">Locações</span>
      </a>
      <a href="<%= clientes_path %>" class="ni <%= current_page?(clientes_path) ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        <span class="ni-lbl">Clientes</span>
      </a>
      <a href="<%= eventos_path %>" class="ni <%= current_page?(eventos_path) ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M12 2v20M2 12h20"/>
          <path d="M8 12h.01M16 12h.01M12 8v.01M12 16v.01"/>
        </svg>
        <span class="ni-lbl">Eventos</span>
      </a>
      <a href="<%= socios_path %>" class="ni <%= current_page?(socios_path) ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="8.5" cy="7" r="4"/>
          <path d="M20 8v6M23 11h-6"/>
        </svg>
        <span class="ni-lbl">Sócios</span>
      </a>
      <a href="<%= participacao_socios_path %>" class="ni <%= current_page?(participacao_socios_path) ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 6v6l4 2"/>
        </svg>
        <span class="ni-lbl">Participações</span>
      </a>
      <a href="<%= usuarios_path %>" class="ni <%= current_page?(usuarios_path) ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        <span class="ni-lbl">Usuários</span>
      </a>
      </nav>
    </div>
  <% else %>
    <% flash.each do |type, message| %>
      <div class="fixed top-4 right-4 z-50">
        <div class="alert a-<%= flash_alert_class(type) %>">
          <div class="a-icon"><%= flash_icon(type) %></div>
          <div>
            <div class="a-title"><%= flash_title(type) %></div>
            <div class="a-sub"><%= message %></div>
          </div>
        </div>
      </div>
    <% end %>
    <%= yield %>
  <% end %>

  <script>
    // Update date/time
    function updateDateTime() {
      const now = new Date();
      const dateEl = document.getElementById('tDate');
      if (dateEl) {
        dateEl.innerHTML = 
          now.toLocaleDateString('pt-BR', {weekday: 'short', day: '2-digit', month: 'short'}).replace(',', '') +
          '<br>' + now.toLocaleTimeString('pt-BR', {hour: '2-digit', minute: '2-digit'});
      }
    }
    
    updateDateTime();
    setInterval(updateDateTime, 60000); // Update every minute
  </script>
</body>
</html>
