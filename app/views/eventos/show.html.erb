<div class="sec-head">
  <div>
    <div class="sec-title">Detalhes do Evento</div>
    <div class="sec-sub">Informações do evento</div>
  </div>
  <div class="btn-row">
    <%= link_to "Editar", edit_evento_path(@evento), class: "btn btn-ghost" %>
    <%= link_to "Voltar", eventos_path, class: "btn btn-ghost" %>
  </div>
</div>

<!-- Informações do Evento -->
<div class="card">
  <div class="card-lbl">Informações do Evento</div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Tipo Evento</div>
      <div class="fvalue"><%= @evento.tipo_evento_text %></div>
    </div>
    <div class="fg">
      <div class="flabel">Fluxo</div>
      <div class="flex items-center gap-2">
        <span class="badge <%= @evento.entrada? ? 'b-green' : 'b-red' %>">
          <%= @evento.fluxo_text %>
        </span>
      </div>
    </div>
  </div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Status</div>
      <div class="flex items-center gap-2">
        <span class="badge 
          <%= case @evento.status 
              when 0 then 'b-yellow'
              when 1 then 'b-green'
              when 2 then 'b-red'
              end %>">
          <%= @evento.status_text %>
        </span>
      </div>
    </div>
    <div class="fg">
      <div class="flabel">Valor</div>
      <div class="fvalue">R$ <%= number_to_currency(@evento.valor, unit: "", separator: ",", delimiter: ".") %></div>
    </div>
  </div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Data Evento</div>
      <div class="fvalue"><%= @evento.data_evento.strftime("%d/%m/%Y") %></div>
    </div>
    <div class="fg">
      <div class="flabel">Responsável</div>
      <div class="fvalue"><%= @evento.responsavel %></div>
    </div>
  </div>
</div>

<% if @evento.tipo_manutencao.present? %>
<!-- Manutenção -->
<div class="card">
  <div class="card-lbl">Manutenção</div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Tipo Manutenção</div>
      <div class="fvalue"><%= @evento.tipo_manutencao_text %></div>
    </div>
    <% if @evento.quilometragem.present? %>
    <div class="fg">
      <div class="flabel">Quilometragem</div>
      <div class="fvalue"><%= @evento.quilometragem %> km</div>
    </div>
    <% end %>
  </div>
</div>
<% end %>

<% if @evento.cliente.present? %>
<!-- Cliente -->
<div class="card">
  <div class="card-lbl">Cliente</div>
  <div class="frow">
    <div class="fg">
      <div class="fvalue">
        <div><%= @evento.cliente.nome %></div>
        <div class="text-sm text-gray-600"><%= @evento.cliente.cpf %></div>
        <div class="text-sm text-gray-600"><%= @evento.cliente.telefone %></div>
      </div>
    </div>
  </div>
</div>
<% end %>

<% if @evento.veiculo.present? %>
<!-- Veículo -->
<div class="card">
  <div class="card-lbl">Veículo</div>
  <div class="frow">
    <div class="fg">
      <div class="fvalue">
        <div><%= @evento.veiculo.placa %> - <%= @evento.veiculo.modelo %></div>
        <div class="text-sm text-gray-600"><%= @evento.veiculo.marca %> <%= @evento.veiculo.ano %></div>
        <div class="text-sm text-gray-600">KM Atual: <%= @evento.veiculo.km_atual %> km</div>
      </div>
    </div>
  </div>
</div>
<% end %>

<% if @evento.locacao.present? %>
<!-- Locação -->
<div class="card">
  <div class="card-lbl">Locação</div>
  <div class="frow">
    <div class="fg">
      <div class="fvalue">
        <div><%= @evento.locacao.numero_contrato %></div>
        <div class="text-sm text-gray-600">Cliente: <%= @evento.locacao.cliente.nome %></div>
        <div class="text-sm text-gray-600">Veículo: <%= @evento.locacao.veiculo.placa %></div>
      </div>
    </div>
  </div>
</div>
<% end %>

<% if @evento.periodo_inicio.present? || @evento.periodo_fim.present? %>
<!-- Período -->
<div class="card">
  <div class="card-lbl">Período</div>
  <div class="frow">
    <% if @evento.periodo_inicio.present? %>
    <div class="fg">
      <div class="flabel">Início</div>
      <div class="fvalue"><%= @evento.periodo_inicio.strftime("%d/%m/%Y") %></div>
    </div>
    <% end %>
    <% if @evento.periodo_fim.present? %>
    <div class="fg">
      <div class="flabel">Fim</div>
      <div class="fvalue"><%= @evento.periodo_fim.strftime("%d/%m/%Y") %></div>
    </div>
    <% end %>
  </div>
</div>
<% end %>

<% if @evento.descricao.present? %>
<!-- Descrição -->
<div class="card">
  <div class="card-lbl">Descrição</div>
  <div class="frow">
    <div class="fg">
      <div class="fvalue"><%= @evento.descricao %></div>
    </div>
  </div>
</div>
<% end %>

<!-- Anexos -->
<% if @evento.anexos.any? %>
<div class="card">
  <div class="card-lbl">
    <%= icon "paperclip", size: 16, style: "vertical-align: middle;" %> 
    Documentos Anexados (<%= @evento.anexos.count %>)
  </div>
  <div style="padding: 10px;">
    <% @evento.anexos.order(created_at: :desc).each do |anexo| %>
      <div style="display: flex; align-items: center; gap: 12px; padding: 12px; margin-bottom: 8px; background: var(--bg2); border-radius: 8px; border: 1px solid var(--border);">
        <!-- File Icon -->
        <div style="flex-shrink: 0; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: var(--bg3); border-radius: 6px; font-size: 20px;">
          <% case anexo.mime_type %>
          <% when /pdf/ %>
            📄
          <% when /image/ %>
            🖼️
          <% when /word/ %>
            📝
          <% when /zip/ %>
            📦
          <% else %>
            📎
          <% end %>
        </div>
        
        <!-- File Info -->
        <div style="flex: 1; min-width: 0;">
          <div style="font-weight: 500; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
            <%= anexo.nome_arquivo %>
          </div>
          <div style="font-size: 12px; color: var(--text3); margin-top: 2px;">
            <span class="badge b-gold" style="font-size: 10px;"><%= anexo.categoria %></span>
            <span style="margin-left: 8px;">
              <%= anexo.created_at.strftime("%d/%m/%Y %H:%M") %>
            </span>
          </div>
        </div>
        
        <!-- Actions -->
        <div style="display: flex; gap: 8px; flex-shrink: 0;">
          <%= link_to anexo.arquivo_url, 
              target: "_blank", 
              class: "btn btn-ghost", 
              style: "font-size: 12px; padding: 4px 8px;",
              title: "Visualizar no Google Drive" do %>
            <%= icon "external-link", size: 14 %> Abrir
          <% end %>
          
          <%= button_to evento_anexo_path(@evento, anexo), 
              method: :delete, 
              class: "btn btn-ghost", 
              style: "font-size: 12px; padding: 4px 8px; color: var(--red);",
              title: "Remover",
              data: { confirm: "Tem certeza que deseja remover este arquivo?" } do %>
            <%= icon "trash", size: 14 %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
<% end %>
