<div class="sec-head">
  <div>
    <div class="sec-title">Editar Evento</div>
    <div class="sec-sub">Atualizar informações do evento</div>
  </div>
</div>

<%= form_with(model: @evento, local: true, class: "max-w-2xl") do |form| %>
  <% if @evento.errors.any? %>
    <div class="alert a-red">
      <div class="a-icon">⚠</div>
      <div>
        <div class="a-title">Erros no formulário</div>
        <div class="a-sub">
          <% @evento.errors.full_messages.each do |message| %>
            • <%= message %><br>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Informações Básicas -->
  <div class="card">
    <div class="card-lbl">Informações Básicas</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :tipo_evento, "Tipo Evento", class: "flabel" %>
        <%= form.select :tipo_evento, 
            options_for_select([
              ["Pagamento Semanal", 0], 
              ["Manutenção", 1], 
              ["Multa", 2], 
              ["Outro", 3]
            ], @evento.tipo_evento), 
            { prompt: "Selecione um tipo" }, 
            class: "fselect" %>
      </div>
      <div class="fg">
        <%= form.label :fluxo, "Fluxo", class: "flabel" %>
        <%= form.select :fluxo, 
            options_for_select([
              ["Entrada", 0], 
              ["Saída", 1]
            ], @evento.fluxo), 
            { prompt: "Selecione um fluxo" }, 
            class: "fselect" %>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <%= form.label :status, "Status", class: "flabel" %>
        <%= form.select :status, 
            options_for_select([
              ["Pendente", 0], 
              ["Pago", 1], 
              ["Cancelado", 2]
            ], @evento.status), 
            { prompt: "Selecione um status" }, 
            class: "fselect" %>
      </div>
      <div class="fg">
        <%= form.label :valor, "Valor", class: "flabel" %>
        <%= form.number_field :valor, step: 0.01, class: "finput", placeholder: "0.00" %>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <%= form.label :data_evento, "Data Evento", class: "flabel" %>
        <%= form.date_field :data_evento, class: "finput" %>
      </div>
      <div class="fg">
        <%= form.label :responsavel, "Responsável", class: "flabel" %>
        <%= form.text_field :responsavel, class: "finput", placeholder: "Nome do responsável" %>
      </div>
    </div>
  </div>

  <!-- Relacionamentos -->
  <div class="card">
    <div class="card-lbl">Relacionamentos</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :cliente_id, "Cliente", class: "flabel" %>
        <%= form.select :cliente_id, 
            options_from_collection_for_select(@clientes, :id, :nome, @evento.cliente_id), 
            { prompt: "Selecione um cliente (opcional)" }, 
            class: "fselect" %>
      </div>
      <div class="fg">
        <%= form.label :veiculo_id, "Veículo", class: "flabel" %>
        <%= form.select :veiculo_id, 
            options_from_collection_for_select(@veiculos, :id, :to_s, @evento.veiculo_id), 
            { prompt: "Selecione um veículo" }, 
            class: "fselect" %>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <%= form.label :locacao_id, "Locação", class: "flabel" %>
        <%= form.select :locacao_id, 
            options_from_collection_for_select(@locacoes, :id, :numero_contrato, @evento.locacao_id), 
            { prompt: "Selecione uma locação (opcional)" }, 
            class: "fselect" %>
      </div>
      <div class="fg">
        <%= form.label :tipo_manutencao, "Tipo Manutenção", class: "flabel" %>
        <%= form.select :tipo_manutencao, 
            options_for_select([
              ["Preventiva", 0], 
              ["Corretiva", 1], 
              ["Revisão", 2]
            ], @evento.tipo_manutencao), 
            { prompt: "Selecione um tipo (apenas para manutenção)" }, 
            class: "fselect" %>
      </div>
    </div>
  </div>

  <!-- Período e Detalhes -->
  <div class="card">
    <div class="card-lbl">Período e Detalhes</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :periodo_inicio, "Período Início", class: "flabel" %>
        <%= form.date_field :periodo_inicio, class: "finput" %>
      </div>
      <div class="fg">
        <%= form.label :periodo_fim, "Período Fim", class: "flabel" %>
        <%= form.date_field :periodo_fim, class: "finput" %>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <%= form.label :quilometragem, "Quilometragem", class: "flabel" %>
        <%= form.number_field :quilometragem, class: "finput", placeholder: "KM" %>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <%= form.label :descricao, "Descrição", class: "flabel" %>
        <%= form.text_area :descricao, class: "finput", rows: 3, placeholder: "Descrição do evento..." %>
      </div>
    </div>
  </div>

  <!-- Botões -->
  <div class="btn-row">
    <%= link_to "Cancelar", @evento, class: "btn btn-ghost" %>
    <%= form.submit "Atualizar Evento", class: "btn btn-gold" %>
  </div>
<% end %>
