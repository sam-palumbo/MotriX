<% content_for :title, "Eventos | MotriX" %>

<div class="sec-head">
  <div>
    <div class="sec-title">Eventos</div>
    <div class="sec-sub"><%= @eventos.size %> eventos registrados</div>
  </div>
  <%= link_to "Novo Evento", new_evento_path, class: "btn btn-gold btn-sm" %>
</div>

<!-- Quick Stats -->
<div class="kgrid">
  <div class="kcard">
    <div class="knum" style="color:var(--green)">
      <%= brl(@eventos.where(fluxo: 'entrada').sum(:valor)) %>
    </div>
    <div class="kdesc">Entradas</div>
  </div>
  <div class="kcard">
    <div class="knum" style="color:var(--red)">
      <%= brl(@eventos.where(fluxo: 'saida').sum(:valor)) %>
    </div>
    <div class="kdesc">Saídas</div>
  </div>
  <div class="kcard">
    <div class="knum" style="color:var(--gold)">
      <%= brl(@eventos.sum(:valor)) %>
    </div>
    <div class="kdesc">Total</div>
  </div>
  <div class="kcard">
    <div class="knum" style="font-size:20px">
      <%= @eventos.where(fluxo: 'entrada').count %>
    </div>
    <div class="kdesc">Pagamentos</div>
  </div>
</div>

<!-- Tabs -->
<div class="tabs">
  <button class="tab active" onclick="filterEventos('todos', this)">Todos</button>
  <button class="tab" onclick="filterEventos('entrada', this)">Entradas</button>
  <button class="tab" onclick="filterEventos('saida', this)">Saídas</button>
  <button class="tab" onclick="filterEventos('pagamento_semanal', this)">Pagamentos</button>
  <button class="tab" onclick="filterEventos('manutencao', this)">Manutenção</button>
</div>

<div id="eventos-list">
  <% @eventos.each do |evento| %>
    <div class="li" data-fluxo="<%= evento.fluxo %>" data-tipo="<%= evento.tipo_evento %>" onclick="window.location.href='<%= evento_path(evento) %>'">
      <div class="li-icon" style="background:<%= evento.fluxo == 'entrada' ? 'rgba(61,186,110,.1)' : 'rgba(224,80,80,.1)' %>">
        <%= evento.fluxo == 'entrada' ? '💰' : evento.tipo_evento == 'manutencao' ? '🔧' : '💸' %>
      </div>
      <div class="li-body">
        <div class="li-title"><%= enum_label(evento.tipo_evento) %></div>
        <div class="li-sub">
          <%= [evento.cliente&.nome, evento.veiculo&.placa, evento.locacao&.numero_contrato].compact.join(" • ") %>
        </div>
        <div class="mt4">
          <span class="badge <%= evento.fluxo == 'entrada' ? 'b-green' : 'b-red' %>">
            <%= enum_label(evento.fluxo) %>
          </span>
          <% if evento.status.present? %>
            <span class="badge <%= evento.status == 'pago' ? 'b-green' : 'b-orange' %>">
              <%= enum_label(evento.status) %>
            </span>
          <% end %>
          <% if evento.tipo_manutencao.present? %>
            <span class="badge b-orange">
              <%= enum_label(evento.tipo_manutencao) %>
            </span>
          <% end %>
        </div>
      </div>
      <div class="li-right">
        <div class="li-val" style="color:<%= evento.fluxo == 'entrada' ? 'var(--green)' : 'var(--red)' %>">
          <%= evento.fluxo == 'entrada' ? '+' : '-' %> <%= brl(evento.valor) %>
        </div>
        <div class="li-date"><%= evento.data_evento.strftime("%d/%m/%Y") %></div>
      </div>
    </div>
  <% end %>
  
  <% if @eventos.empty? %>
    <div class="empty">
      <div class="empty-ico">📊</div>
      <div style="font-size:13px">Nenhum evento registrado</div>
    </div>
  <% end %>
</div>

<script>
function filterEventos(filter, element) {
  // Update active tab
  document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('active'));
  element.classList.add('active');
  
  // Filter eventos
  const eventos = document.querySelectorAll('#eventos-list .li');
  eventos.forEach(evento => {
    if (filter === 'todos') {
      evento.style.display = 'flex';
    } else if (filter === 'entrada' || filter === 'saida') {
      evento.style.display = evento.dataset.fluxo === filter ? 'flex' : 'none';
    } else {
      evento.style.display = evento.dataset.tipo === filter ? 'flex' : 'none';
    }
  });
}
</script>
