<% content_for :title, "Registrar Evento | MotriX" %>

<div class="sec-head">
  <div>
    <div class="sec-title">Registrar</div>
    <div class="sec-sub">Lançar eventos</div>
  </div>
</div>

<!-- Locação -->
<div class="sec-lbl">Locação</div>
<div class="li" onclick="window.location.href='<%= new_evento_path(tipo: 'pagamento_semanal') %>'">
  <div class="li-icon" style="background:rgba(61,186,110,.1)">💰</div>
  <div class="li-body">
    <div class="li-title">Pagamento semanal</div>
    <div class="li-sub">Registrar semana de locação</div>
  </div>
  <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
</div>
<div class="li" onclick="window.location.href='<%= new_evento_path(tipo: 'retirada') %>'">
  <div class="li-icon" style="background:rgba(80,144,240,.1)">🔑</div>
  <div class="li-body">
    <div class="li-title">Retirada de veículo</div>
    <div class="li-sub">Novo cliente retirando moto</div>
  </div>
  <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
</div>
<div class="li" onclick="window.location.href='<%= new_evento_path(tipo: 'devolucao') %>'">
  <div class="li-icon" style="background:rgba(144,112,232,.1)">↩️</div>
  <div class="li-body">
    <div class="li-title">Devolução de veículo</div>
    <div class="li-sub">Encerrar locação</div>
  </div>
  <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
</div>

<!-- Despesas -->
<div class="sec-lbl mt8">Despesas</div>
<div class="li" onclick="window.location.href='<%= new_evento_path(tipo: 'manutencao') %>'">
  <div class="li-icon" style="background:rgba(224,120,48,.1)">🔧</div>
  <div class="li-body">
    <div class="li-title">Manutenção de veículo</div>
    <div class="li-sub">Registrar serviço ou reparo</div>
  </div>
  <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
</div>
<div class="li" onclick="window.location.href='<%= new_evento_path(tipo: 'gasto_empresa') %>'">
  <div class="li-icon" style="background:rgba(224,80,80,.1)">📋</div>
  <div class="li-body">
    <div class="li-title">Gasto da empresa</div>
    <div class="li-sub">Despesa geral não vinculada</div>
  </div>
  <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
</div>

<!-- Últimos eventos -->
<div class="sec-lbl mt8" style="display:flex;align-items:center;justify-content:space-between;padding-right:16px">
  <span>📋 Últimos eventos</span>
  <%= link_to "Ver todos", eventos_path, style: "background:none;border:none;color:var(--text3);font-size:11px;cursor:pointer;font-family:inherit;text-decoration:none" %>
</div>
<div id="eventos-list">
  <% @eventos.limit(5).each do |evento| %>
    <div class="li" onclick="window.location.href='<%= evento_path(evento) %>'">
      <div class="li-icon" style="background:<%= evento.fluxo == 'entrada' ? 'rgba(61,186,110,.1)' : 'rgba(224,80,80,.1)' %>">
        <%= evento.fluxo == 'entrada' ? '💰' : evento.tipo_evento == 'manutencao' ? '🔧' : '💸' %>
      </div>
      <div class="li-body">
        <div class="li-title"><%= enum_label(evento.tipo_evento) %></div>
        <div class="li-sub">
          <%= [evento.cliente&.nome, evento.veiculo&.placa, evento.locacao&.numero_contrato].compact.join(" • ") %>
        </div>
      </div>
      <div class="li-right">
        <div class="li-val" style="color:<%= evento.fluxo == 'entrada' ? 'var(--green)' : 'var(--red)' %>">
          <%= evento.fluxo == 'entrada' ? '+' : '-' %> <%= brl(evento.valor) %>
        </div>
        <div class="li-date"><%= evento.data_evento.strftime("%d/%m/%Y") %></div>
      </div>
    </div>
  <% end %>

  <% if @eventos.empty? %>
    <div class="empty">
      <div class="empty-ico">📊</div>
      <div style="font-size:13px">Nenhum evento registrado</div>
    </div>
  <% end %>
</div>
