<div class="sec-head">
  <div>
    <div class="sec-title">Novo Evento</div>
    <div class="sec-sub">Registrar evento financeiro ou operacional</div>
  </div>
</div>

<%= form_with(model: @evento, local: true, class: "max-w-2xl", multipart: true) do |form| %>
  <% if @evento.errors.any? %>
    <div class="alert a-red">
      <div class="a-icon">⚠</div>
      <div>
        <div class="a-title">Erros no formulário</div>
        <div class="a-sub">
          <% @evento.errors.full_messages.each do |message| %>
            • <%= message %><br>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Informações Básicas -->
  <div class="card">
    <div class="card-lbl">Informações do Evento</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :tipo_evento, "Tipo do Evento *", class: "flabel" %>
        <%= form.select :tipo_evento, 
            options_for_select([
              ["Pagamento Semanal", 0], 
              ["Manutenção", 1], 
              ["Gasto Empresa", 2], 
              ["Retirada", 3],
              ["Devolução", 4],
              ["Aquisição Veículo", 5],
              ["Saída Frota", 6]
            ], @evento.tipo_evento), 
            { prompt: "Selecione um tipo", required: true }, 
            class: "fselect" %>
      </div>
      <div class="fg">
        <%= form.label :fluxo, "Fluxo Financeiro *", class: "flabel" %>
        <%= form.select :fluxo, 
            options_for_select([
              ["Entrada", 0], 
              ["Saída", 1]
            ], @evento.fluxo), 
            { prompt: "Selecione o fluxo", required: true }, 
            class: "fselect" %>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <%= form.label :status, "Status", class: "flabel" %>
        <%= form.select :status, 
            options_for_select([
              ["Pendente", 0], 
              ["Pago", 1], 
              ["Cancelado", 2]
            ], @evento.status), 
            { prompt: "Selecione um status" }, 
            class: "fselect" %>
      </div>
      <div class="fg">
        <%= form.label :valor, "Valor (R$) *", class: "flabel" %>
        <%= form.number_field :valor, step: 0.01, class: "finput", placeholder: "0,00", required: true %>
      </div>
    </div>
  </div>

  <!-- Datas e Responsável -->
  <div class="card">
    <div class="card-lbl">Data e Responsável</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :data_evento, "Data do Evento *", class: "flabel" %>
        <%= form.date_field :data_evento, class: "finput", value: Date.current, required: true %>
      </div>
      <div class="fg">
        <%= form.label :responsavel, "Responsável *", class: "flabel" %>
        <%= form.text_field :responsavel, class: "finput", value: Current.usuario&.nome, placeholder: "Nome do responsável", required: true %>
      </div>
    </div>
  </div>

  <!-- Relacionamentos -->
  <div class="card">
    <div class="card-lbl">Relacionamentos (Opcional)</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :cliente_id, "Cliente", class: "flabel" %>
        <%= form.select :cliente_id, 
            options_from_collection_for_select(@clientes, :id, :nome, @evento.cliente_id), 
            { prompt: "Selecione um cliente (opcional)" }, 
            class: "fselect" %>
      </div>
      <div class="fg">
        <%= form.label :veiculo_id, "Veículo", class: "flabel" %>
        <%= form.select :veiculo_id, 
            options_from_collection_for_select(@veiculos, :id, :to_s, @evento.veiculo_id), 
            { prompt: "Selecione um veículo" }, 
            class: "fselect" %>
      </div>
    </div>
    <div class="fg">
      <%= form.label :locacao_id, "Locação", class: "flabel" %>
      <%= form.select :locacao_id, 
          options_from_collection_for_select(@locacoes, :id, :numero_contrato, @evento.locacao_id), 
          { prompt: "Selecione uma locação (opcional)" }, 
          class: "fselect" %>
    </div>
  </div>

  <!-- Manutenção (se aplicável) -->
  <div class="card">
    <div class="card-lbl">Dados de Manutenção</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :tipo_manutencao, "Tipo de Manutenção", class: "flabel" %>
        <%= form.select :tipo_manutencao, 
            options_for_select([
              ["Preventiva", 0], 
              ["Corretiva", 1], 
              ["Revisão", 2]
            ], @evento.tipo_manutencao), 
            { prompt: "Apenas para eventos de manutenção" }, 
            class: "fselect" %>
      </div>
      <div class="fg">
        <%= form.label :quilometragem, "Quilometragem", class: "flabel" %>
        <%= form.number_field :quilometragem, class: "finput", placeholder: "0" %>
      </div>
    </div>
  </div>

  <!-- Período (para pagamentos) -->
  <div class="card">
    <div class="card-lbl">Período Referência</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :periodo_inicio, "Início do Período", class: "flabel" %>
        <%= form.date_field :periodo_inicio, class: "finput", value: Date.current.beginning_of_week %>
      </div>
      <div class="fg">
        <%= form.label :periodo_fim, "Fim do Período", class: "flabel" %>
        <%= form.date_field :periodo_fim, class: "finput", value: Date.current.end_of_week %>
      </div>
    </div>
  </div>

  <!-- Descrição -->
  <div class="card">
    <div class="card-lbl">Descrição do Evento</div>
    <div class="fg">
      <%= form.label :descricao, "Detalhes importantes", class: "flabel" %>
      <%= form.text_area :descricao, class: "ftextarea", placeholder: "Descreva os detalhes deste evento..." %>
    </div>
  </div>

  <!-- Anexos / Documentos -->
  <div class="card">
    <div class="card-lbl">
      <%= icon "cloud-upload", size: 16, style: "vertical-align: middle;" %> 
      Anexar Documentos (Google Drive)
    </div>
    
    <div style="padding: 10px;">
      <!-- Upload Fields -->
      <div class="frow" style="margin-bottom: 12px;">
        <div class="fg" style="flex: 2;">
          <%= label_tag "anexos[comprovante][arquivo]", "Comprovante de Pagamento", class: "flabel" %>
          <%= file_field_tag "anexos[comprovante][arquivo]", 
              class: "finput", 
              accept: ".pdf,.jpg,.jpeg,.png,.gif",
              style: "font-size: 13px;" %>
        </div>
        <div class="fg" style="flex: 1;">
          <%= hidden_field_tag "anexos[comprovante][categoria]", "comprovante_pagamento" %>
        </div>
      </div>
      
      <div class="frow" style="margin-bottom: 12px;">
        <div class="fg" style="flex: 2;">
          <%= label_tag "anexos[hodometro][arquivo]", "Hodômetro", class: "flabel" %>
          <%= file_field_tag "anexos[hodometro][arquivo]", 
              class: "finput", 
              accept: ".jpg,.jpeg,.png,.gif",
              style: "font-size: 13px;" %>
        </div>
        <div class="fg" style="flex: 1;">
          <%= hidden_field_tag "anexos[hodometro][categoria]", "hodometro" %>
        </div>
      </div>
      
      <div class="frow" style="margin-bottom: 12px;">
        <div class="fg" style="flex: 2;">
          <%= label_tag "anexos[foto][arquivo]", "Foto do Veículo", class: "flabel" %>
          <%= file_field_tag "anexos[foto][arquivo]", 
              class: "finput", 
              accept: ".jpg,.jpeg,.png,.gif",
              style: "font-size: 13px;" %>
        </div>
        <div class="fg" style="flex: 1;">
          <%= hidden_field_tag "anexos[foto][categoria]", "foto_veiculo" %>
        </div>
      </div>
      
      <div class="frow">
        <div class="fg" style="flex: 2;">
          <%= label_tag "anexos[outro][arquivo]", "Outro Documento", class: "flabel" %>
          <%= file_field_tag "anexos[outro][arquivo]", 
              class: "finput", 
              accept: ".pdf,.doc,.docx,.jpg,.jpeg,.png,.gif,.zip,.rar",
              style: "font-size: 13px;" %>
        </div>
        <div class="fg" style="flex: 1;">
          <%= label_tag "anexos[outro][categoria]", "Tipo", class: "flabel" %>
          <%= select_tag "anexos[outro][categoria]",
              options_for_select([
                ["Outros", "outros"],
                ["Documento", "documento"],
                ["Contrato", "contrato"],
                ["Nota Fiscal", "nota_fiscal"]
              ]),
              class: "fselect",
              style: "font-size: 13px;" %>
        </div>
      </div>
      
      <div style="font-size: 12px; color: var(--text3); margin-top: 12px; text-align: center;">
        <%= icon "cloud-upload", size: 12, style: "vertical-align: middle;" %> 
        Os arquivos serão enviados automaticamente para o Google Drive ao registrar o evento
      </div>
    </div>
  </div>

  <!-- Botões -->
  <div class="btn-row">
    <%= link_to "Cancelar", eventos_path, class: "btn btn-ghost" %>
    <%= form.submit "Registrar Evento", class: "btn btn-gold" %>
  </div>
<% end %>
