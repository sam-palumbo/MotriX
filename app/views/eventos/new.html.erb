<%# Determine event type from params or from @evento.tipo_evento %>
<% evento_tipo = params[:tipo] || (@evento.tipo_evento.present? ? @evento.tipo_evento : nil) %>
<% tipo_labels = { 'pagamento_semanal' => '💰 Pagamento Semanal', 'retirada' => '🔑 Retirada de Veículo', 'devolucao' => '↩️ Devolução de Veículo', 'manutencao' => '🔧 Manutenção de Veículo', 'gasto_empresa' => '📋 Gasto da Empresa' } %>

<div class="sec-head">
  <div>
    <div class="sec-title"><%= evento_tipo ? tipo_labels[evento_tipo.to_s] : 'Novo Evento' %></div>
    <div class="sec-sub"><%= evento_tipo ? 'Registrar evento' : 'Registrar evento financeiro ou operacional' %></div>
  </div>
</div>

<%= form_with(model: @evento, local: true, class: "max-w-2xl", multipart: true) do |form| %>
  <% if @evento.errors.any? %>
    <div class="alert a-red">
      <div class="a-icon">⚠</div>
      <div>
        <div class="a-title">Erros no formulário</div>
        <div class="a-sub">
          <% @evento.errors.full_messages.each do |message| %>
            • <%= message %><br>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Hidden fields for pre-filled values -->
  <%= form.hidden_field :tipo_evento if evento_tipo %>
  <%= form.hidden_field :fluxo if evento_tipo %>
  <%= form.hidden_field :status if evento_tipo %>

  <!-- Relacionamentos (show for Pagamento, Retirada, Devolução, Manutenção) - FIRST SECTION -->
  <% if !evento_tipo || ['pagamento_semanal', 'retirada', 'devolucao', 'manutencao'].include?(evento_tipo.to_s) %>
  <div class="card">
    <div class="card-lbl">Veículo</div>
    <div class="fg">
      <%= form.label :veiculo_id, "Selecione o veículo *", class: "flabel" %>
      <%= form.select :veiculo_id,
          options_from_collection_for_select(@veiculos, :id, :to_s, @evento.veiculo_id),
          { prompt: "Selecione um veículo", required: true },
          class: "fselect",
          id: "evento-veiculo-select" %>
      <div style="font-size: 10px; color: var(--text3); margin-top: 3px;">Selecione um veículo</div>
    </div>

    <!-- Cliente Selection (always visible field) -->
    <div class="fg">
      <%= form.label :cliente_id, "Cliente *", class: "flabel" %>
      <%= form.select :cliente_id,
          options_from_collection_for_select(@clientes, :id, :nome, @evento.cliente_id),
          { prompt: "Selecione um cliente", required: true },
          class: "fselect",
          id: "evento-cliente-select" %>
    </div>

    <!-- Hidden field for locacao (always present) -->
    <%= form.hidden_field :locacao_id, id: "evento-locacao-id" %>

    <!-- Info Box for Vehicle -->
    <div class="finfo" id="veiculo-info" style="display: none;">
      <div class="finfo-lbl">Veículo selecionado</div>
      <div class="finfo-val" id="veiculo-info-val">—</div>
    </div>

    <!-- Info Box for Cliente (auto-populated) -->
    <div class="finfo" id="cliente-info" style="display: none;">
      <div class="finfo-lbl">Cliente associado</div>
      <div class="finfo-val" id="cliente-info-val">—</div>
    </div>

    <!-- Info Box for Locacao (auto-populated) -->
    <div class="finfo" id="locacao-info" style="display: none;">
      <div class="finfo-lbl">Locação ativa</div>
      <div class="finfo-val" id="locacao-info-val">—</div>
    </div>
  </div>
  <% end %>

  
  <!-- Informações Básicas (only show if no tipo pre-selected) -->
  <% unless evento_tipo %>
  <div class="card">
    <div class="card-lbl">Informações do Evento</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :tipo_evento, "Tipo do Evento *", class: "flabel" %>
        <%= form.select :tipo_evento,
            options_for_select([
              ["Pagamento Semanal", 0],
              ["Manutenção", 1],
              ["Gasto Empresa", 2],
              ["Retirada", 3],
              ["Devolução", 4],
              ["Aquisição Veículo", 5],
              ["Saída Frota", 6]
            ], @evento.tipo_evento),
            { prompt: "Selecione um tipo", required: true },
            class: "fselect" %>
      </div>
      <div class="fg">
        <%= form.label :fluxo, "Fluxo Financeiro *", class: "flabel" %>
        <%= form.select :fluxo,
            options_for_select([
              ["Entrada", 0],
              ["Saída", 1]
            ], @evento.fluxo),
            { prompt: "Selecione o fluxo", required: true },
            class: "fselect" %>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <%= form.label :status, "Status", class: "flabel" %>
        <%= form.select :status,
            options_for_select([
              ["Pendente", 0],
              ["Pago", 1],
              ["Cancelado", 2]
            ], @evento.status),
            { prompt: "Selecione um status" },
            class: "fselect" %>
      </div>
      <div class="fg">
        <%= form.label :valor, "Valor (R$) *", class: "flabel" %>
        <%= form.number_field :valor, step: 0.01, class: "finput", placeholder: "0,00", required: true %>
        <div style="font-size: 10px; color: var(--text3); margin-top: 3px;">Use vírgula para centavos</div>
      </div>
    </div>
  </div>
  <% end %>

  <!-- Valor field (show separately if tipo is pre-selected) -->
  <% if evento_tipo %>
  <div class="card">
    <div class="card-lbl">Valor</div>
    <div class="fg">
      <%= form.label :valor, "Valor (R$) *", class: "flabel" %>
      <%= form.number_field :valor, step: 0.01, class: "finput", placeholder: "0,00", required: true %>
      <div style="font-size: 10px; color: var(--text3); margin-top: 3px;">Use vírgula para centavos</div>
    </div>
  </div>
  <% end %>

  <!-- Datas e Responsável -->
  <div class="card">
    <div class="card-lbl">Data e Responsável</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :data_evento, "Data do Evento *", class: "flabel" %>
        <%= form.date_field :data_evento, class: "finput", value: @evento.data_evento || Date.current, required: true %>
        <div style="font-size: 10px; color: var(--text3); margin-top: 3px;">Data em que o evento ocorreu</div>
      </div>
      <div class="fg">
        <%= form.label :responsavel, "Responsável *", class: "flabel" %>
        <%= form.text_field :responsavel, class: "finput", value: Current.usuario&.nome, placeholder: "Nome do responsável", required: true %>
      </div>
    </div>
  </div>

  <!-- Manutenção (only for Manutenção type) -->
  <% if !evento_tipo || evento_tipo.to_s == 'manutencao' %>
  <div class="card">
    <div class="card-lbl">Dados da Manutenção</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :data_evento, "Data do serviço", class: "flabel" %>
        <%= form.date_field :data_evento, class: "finput", value: @evento.data_evento || Date.current %>
      </div>
      <div class="fg">
        <%= form.label :quilometragem, "KM no serviço", class: "flabel" %>
        <%= form.number_field :quilometragem, class: "finput", placeholder: "Ex: 45000" %>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <%= form.label :tipo_manutencao, "Tipo de serviço", class: "flabel" %>
        <%= form.select :tipo_manutencao,
            options_for_select([
              ["Troca de óleo", 0],
              ["Troca da relação", 1],
              ["Pastilhas de freio dianteira", 2],
              ["Disco de freio dianteiro", 3],
              ["Lona de freio traseira", 4],
              ["Pneu dianteiro", 5],
              ["Pneu traseiro", 6],
              ["Vela de ignição", 7],
              ["Lona de freio dianteira", 8],
              ["Outros", 9]
            ], @evento.tipo_manutencao),
            { prompt: "Selecione o tipo" },
            class: "fselect" %>
      </div>
      <div class="fg">
        <label class="flabel">Pago por</label>
        <select name="pago_por" class="fselect">
          <option value="4A">4A</option>
          <option value="CLIENTE">CLIENTE</option>
        </select>
      </div>
    </div>
  </div>
  
  <div class="card">
    <div class="card-lbl">Serviços Realizados</div>
    <div id="servicos-list">
      <div class="serv-item">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <span style="font-size: 11px; font-weight: 700; color: var(--gold); background: rgba(232,197,71,0.1); padding: 2px 8px; border-radius: 10px;">1</span>
          <button type="button" class="btn btn-sm" onclick="this.parentElement.parentElement.remove()" style="background: none; border: none; color: var(--text3); font-size: 16px; padding: 0;">✕</button>
        </div>
        <div class="frow">
          <div class="fg">
            <input type="text" name="servicos[][descricao]" class="finput" placeholder="Descrição do serviço" required>
          </div>
          <div class="fg">
            <input type="number" name="servicos[][valor]" class="finput" placeholder="0,00" step="0.01" required onchange="calcularTotalServicos()">
          </div>
        </div>
      </div>
    </div>
    <button type="button" class="btn btn-ghost" onclick="adicionarServico()" style="margin-top: 8px;">+ Adicionar serviço</button>
  </div>
  
  <div class="card">
    <div class="card-lbl">Resumo</div>
    <div class="frow">
      <div class="fg">
        <label class="flabel">Total dos serviços</label>
        <input type="number" id="total-servicos" class="finput" placeholder="0,00" step="0.01" readonly style="background: var(--bg2); color: var(--gold); font-weight: 700;">
      </div>
    </div>
  </div>
  <% end %>

  <!-- Período (only for Pagamento Semanal type) -->
  <% if !evento_tipo || evento_tipo.to_s == 'pagamento_semanal' %>
  <div class="card">
    <div class="card-lbl">Período Referência</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :periodo_inicio, "Início do Período", class: "flabel" %>
        <%= form.date_field :periodo_inicio, class: "finput", value: @evento.periodo_inicio || Date.current.beginning_of_week %>
      </div>
      <div class="fg">
        <%= form.label :periodo_fim, "Fim do Período", class: "flabel" %>
        <%= form.date_field :periodo_fim, class: "finput", value: @evento.periodo_fim || Date.current.end_of_week %>
      </div>
    </div>
  </div>
  <% end %>

  <!-- Retirada specific fields -->
  <% if evento_tipo.to_s == 'retirada' %>
  <div class="card">
    <div class="card-lbl">Dados da Locação</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :data_inicio, "Início da locação *", class: "flabel" %>
        <%= form.date_field :data_inicio, class: "finput", value: Date.current, required: true %>
      </div>
      <div class="fg">
        <%= form.label :data_prevista_fim, "Previsão de fim *", class: "flabel" %>
        <%= form.date_field :data_prevista_fim, class: "finput", value: Date.current + 7.days, required: true %>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <%= form.label :valor_semanal, "Valor semanal (R$) *", class: "flabel" %>
        <%= form.number_field :valor_semanal, step: 0.01, class: "finput", placeholder: "0,00", required: true %>
      </div>
      <div class="fg">
        <label class="flabel">Caução recebido (R$)</label>
        <input type="number" name="caucao_valor" class="finput" placeholder="0,00" step="0.01">
        <div style="font-size: 10px; color: var(--text3); margin-top: 3px;">Será registrado no veículo</div>
      </div>
    </div>
  </div>
  
  <div class="card">
    <div class="card-lbl">Dados da Retirada</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :quilometragem, "KM na retirada", class: "flabel" %>
        <%= form.number_field :quilometragem, class: "finput", placeholder: "Ex: 45000" %>
      </div>
      <div class="fg">
        <label class="flabel">Número do contrato</label>
        <input type="text" name="numero_contrato" class="finput" placeholder="Ex: LOC-001" required>
      </div>
    </div>
  </div>
  <% end %>

  <!-- Devolução specific fields -->
  <% if evento_tipo.to_s == 'devolucao' %>
  <div class="card">
    <div class="card-lbl">Dados da Devolução</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :data_fim, "Data de encerramento *", class: "flabel" %>
        <%= form.date_field :data_fim, class: "finput", value: Date.current, required: true %>
      </div>
      <div class="fg">
        <%= form.label :quilometragem, "KM na devolução", class: "flabel" %>
        <%= form.number_field :quilometragem, class: "finput", placeholder: "Ex: 45000" %>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <label class="flabel">Valor final a pagar (R$)</label>
        <input type="number" name="valor_final" class="finput" placeholder="0,00" step="0.01">
        <div style="font-size: 10px; color: var(--text3); margin-top: 3px;">Incluir multas e descontos se houver</div>
      </div>
      <div class="fg">
        <label class="flabel">Devolução de caução (R$)</label>
        <input type="number" name="devolucao_caucao" class="finput" placeholder="0,00" step="0.01">
        <div style="font-size: 10px; color: var(--text3); margin-top: 3px;">Valor devolvido ao cliente</div>
      </div>
    </div>
  </div>
  <% end %>

  <!-- Gasto Empresa specific fields -->
  <% if evento_tipo.to_s == 'gasto_empresa' %>
  <div class="card">
    <div class="card-lbl">Dados do Gasto</div>
    <div class="fg">
      <label class="flabel">Categoria</label>
      <select class="fselect">
        <option>Combustível</option>
        <option>Logística / Transporte</option>
        <option>Cartório / Documentação</option>
        <option>Imposto / Taxa</option>
        <option>Equipamento</option>
        <option>Marketing</option>
        <option>Outro</option>
      </select>
    </div>
  </div>
  <% end %>

  <!-- Descrição -->
  <div class="card">
    <div class="card-lbl">Descrição do Evento</div>
    <div class="fg">
      <%= form.label :descricao, "Detalhes importantes", class: "flabel" %>
      <%= form.text_area :descricao, class: "ftextarea", placeholder: "Descreva os detalhes deste evento..." %>
    </div>
  </div>

  <!-- Anexos / Documentos -->
  <div class="card">
    <div class="card-lbl">
      <%= icon "cloud-upload", size: 16, style: "vertical-align: middle;" %>
      Anexar Documentos (Google Drive)
    </div>

    <div style="padding: 10px;">
      <!-- Upload Area -->
      <div class="anexo-area" id="evento-upload-area">
        <%= file_field_tag "anexos[arquivo]",
            id: "evento-file-input",
            accept: "image/*,.pdf,.doc,.docx",
            multiple: true,
            capture: "environment" %>
        <div class="anexo-area-ico">📷</div>
        <div class="anexo-area-txt">Toque para tirar foto ou selecionar arquivo</div>
        <div class="anexo-area-sub">Imagens, PDF — máx. 10MB por arquivo</div>
      </div>

      <!-- File List (will be populated by JavaScript) -->
      <div class="anexo-lista" id="evento-anexo-lista"></div>

      <!-- Category Selection -->
      <div class="fg" id="categoria-select-group" style="display: none;">
        <label class="flabel">📂 Salvar em:</label>
        <%= select_tag "anexos[categoria]",
            options_for_select([
              ["Comprovante de pagamento", "comprovante_pagamento"],
              ["Hodômetro", "hodometro"],
              ["Foto do veículo", "foto_veiculo"],
              ["Nota fiscal", "nota_fiscal"],
              ["Documento do cliente (CNH/RG)", "documento_cliente"],
              ["Comprovante de caução", "comprovante_caucao"],
              ["Contrato", "contrato"],
              ["Registro de avaria", "registro_avaria"],
              ["Comprovante de garantia", "comprovante_garantia"],
              ["Outro", "outro"]
            ]),
            class: "fselect",
            id: "anexo-categoria-select" %>
        <div style="font-size: 10px; color: var(--text3); margin-top: 3px;" id="categoria-hint">Selecione a categoria do documento</div>
      </div>

      <div style="font-size: 12px; color: var(--text3); margin-top: 12px; text-align: center;">
        <%= icon "cloud-upload", size: 12, style: "vertical-align: middle;" %>
        Os arquivos serão enviados automaticamente para o Google Drive ao registrar o evento
      </div>
    </div>
  </div>

  <script>
    // Vehicle and Client selection handlers with bidirectional auto-population
    (function() {
      // Vehicle data with associated cliente and locacao
      const veiculoData = {
        <% @veiculos.each do |v| %>
          "<%= v.id %>": {
            placa: "<%= j v.placa %>",
            marca: "<%= j v.marca.to_s %>",
            modelo: "<%= j v.modelo.to_s %>",
            <% active_locacao = v.locacoes.where(status: :ativa).first %>
            clienteId: "<%= (active_locacao&.cliente_id || '') %>",
            clienteNome: "<%= j (active_locacao&.cliente&.nome || '') %>",
            locacaoId: "<%= (active_locacao&.id || '') %>",
            locacaoNumero: "<%= j (active_locacao&.numero_contrato || '') %>"
          }<%= "," unless v == @veiculos.last %>
        <% end %>
      };
      
      // Client data with associated veiculo and locacao
      const clienteData = {
        <% @clientes.each do |c| %>
          "<%= c.id %>": {
            nome: "<%= j c.nome %>",
            <% active_locacao = c.locacoes.where(status: :ativa).first %>
            veiculoId: "<%= (active_locacao&.veiculo_id || '') %>",
            veiculoPlaca: "<%= j (active_locacao&.veiculo&.to_s || '') %>",
            locacaoId: "<%= (active_locacao&.id || '') %>",
            locacaoNumero: "<%= j (active_locacao&.numero_contrato || '') %>"
          }<%= "," unless c == @clientes.last %>
        <% end %>
      };

      const veiculoSelect = document.getElementById('evento-veiculo-select');
      const clienteSelect = document.getElementById('evento-cliente-select');
      const veiculoInfo = document.getElementById('veiculo-info');
      const veiculoInfoVal = document.getElementById('veiculo-info-val');
      const clienteInfo = document.getElementById('cliente-info');
      const clienteInfoVal = document.getElementById('cliente-info-val');
      const locacaoInfo = document.getElementById('locacao-info');
      const locacaoInfoVal = document.getElementById('locacao-info-val');
      const locacaoIdField = document.getElementById('evento-locacao-id');

      // Vehicle selection handler
      if (veiculoSelect) {
        veiculoSelect.addEventListener('change', function() {
          const selectedOption = this.options[this.selectedIndex];
          const veiculoId = this.value;

          if (veiculoId && veiculoId !== '') {
            // Show vehicle info
            veiculoInfo.style.display = 'block';
            veiculoInfoVal.textContent = selectedOption.text;

            // Auto-populate cliente and locacao from veiculoData
            if (typeof veiculoData !== 'undefined') {
              const data = veiculoData[veiculoId];
              
              if (data) {
                // Show cliente info if there's an active locacao
                if (data.clienteId && data.clienteNome) {
                  clienteInfo.style.display = 'block';
                  clienteInfoVal.textContent = data.clienteNome;
                  clienteSelect.value = data.clienteId;
                  clienteSelect.dispatchEvent(new Event('change'));
                } else {
                  clienteInfo.style.display = 'none';
                }
                
                // Show locacao info if there's an active locacao
                if (data.locacaoId && data.locacaoNumero) {
                  locacaoInfo.style.display = 'block';
                  locacaoInfoVal.textContent = data.locacaoNumero;
                  locacaoIdField.value = data.locacaoId;
                } else {
                  locacaoInfo.style.display = 'none';
                  locacaoIdField.value = '';
                }
              }
            }
          } else {
            // Clear all
            veiculoInfo.style.display = 'none';
            clienteInfo.style.display = 'none';
            locacaoInfo.style.display = 'none';
            locacaoIdField.value = '';
          }
        });
      }

      // Client selection handler
      if (clienteSelect) {
        clienteSelect.addEventListener('change', function() {
          const selectedOption = this.options[this.selectedIndex];
          const clienteId = this.value;

          if (clienteId && clienteId !== '') {
            // Auto-populate veiculo and locacao from clienteData
            if (typeof clienteData !== 'undefined') {
              const data = clienteData[clienteId];
              
              if (data) {
                // Auto-select veiculo if there's an active locacao
                if (data.veiculoId && data.veiculoPlaca) {
                  veiculoSelect.value = data.veiculoId;
                  
                  // Update vehicle info display
                  veiculoInfo.style.display = 'block';
                  veiculoInfoVal.textContent = data.veiculoPlaca;
                }
                
                // Show locacao info if there's an active locacao
                if (data.locacaoId && data.locacaoNumero) {
                  locacaoInfo.style.display = 'block';
                  locacaoInfoVal.textContent = data.locacaoNumero;
                  locacaoIdField.value = data.locacaoId;
                } else {
                  locacaoInfo.style.display = 'none';
                  locacaoIdField.value = '';
                }
              }
            }
          } else {
            // Clear cliente info when no client selected
            clienteInfo.style.display = 'none';
          }
        });
      }
    })();

    // Simple file upload preview without drag-and-drop for now
    document.getElementById('evento-file-input').addEventListener('change', function(e) {
      const files = Array.from(e.target.files);
      const lista = document.getElementById('evento-anexo-lista');
      const categoriaGroup = document.getElementById('categoria-select-group');

      if (files.length > 0) {
        categoriaGroup.style.display = 'block';
      }

      files.forEach(file => {
        if (file.size > 10 * 1024 * 1024) {
          alert(file.name + ' excede 10MB');
          return;
        }

        const icon = file.type.startsWith('image/') ? '🖼️' :
                    file.type.includes('pdf') ? '📋' :
                    file.type.includes('word') ? '📝' : '📄';

        const item = document.createElement('div');
        item.className = 'anexo-item';
        item.innerHTML = `
          <div class="anexo-item-ico">${icon}</div>
          <div class="anexo-item-info">
            <div class="anexo-item-nome">${file.name}</div>
            <div class="anexo-item-status">${(file.size / 1024 / 1024).toFixed(1)} MB</div>
          </div>
          <button type="button" class="anexo-item-rem" onclick="this.parentElement.remove()">✕</button>
        `;
        lista.appendChild(item);
      });
    });

    // Functions for maintenance form
    window.adicionarServico = function() {
      const servicosList = document.getElementById('servicos-list');
      const servicoCount = servicosList.children.length + 1;
      
      const servicoItem = document.createElement('div');
      servicoItem.className = 'serv-item';
      servicoItem.innerHTML = `
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <span style="font-size: 11px; font-weight: 700; color: var(--gold); background: rgba(232,197,71,0.1); padding: 2px 8px; border-radius: 10px;">${servicoCount}</span>
          <button type="button" class="btn btn-sm" onclick="this.parentElement.parentElement.remove(); calcularTotalServicos();" style="background: none; border: none; color: var(--text3); font-size: 16px; padding: 0;">✕</button>
        </div>
        <div class="frow">
          <div class="fg">
            <input type="text" name="servicos[][descricao]" class="finput" placeholder="Descrição do serviço" required>
          </div>
          <div class="fg">
            <input type="number" name="servicos[][valor]" class="finput" placeholder="0,00" step="0.01" required onchange="calcularTotalServicos()">
          </div>
        </div>
      `;
      
      servicosList.appendChild(servicoItem);
    };

    window.calcularTotalServicos = function() {
      const servicoInputs = document.querySelectorAll('input[name="servicos[][valor]"]');
      const totalInput = document.getElementById('total-servicos');
      
      let total = 0;
      servicoInputs.forEach(input => {
        const valor = parseFloat(input.value) || 0;
        total += valor;
      });
      
      totalInput.value = total.toFixed(2);
    };
  </script>

  <!-- Botões -->
  <div class="btn-row">
    <%= link_to "Cancelar", eventos_path, class: "btn btn-ghost" %>
    <%= form.submit "Registrar Evento", class: "btn btn-gold" %>
  </div>
<% end %>
