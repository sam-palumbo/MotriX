<div class="max-w-2xl mx-auto">
  <div class="bg-white shadow-sm rounded-lg">
    <div class="px-6 py-4 border-b border-gray-200">
      <h1 class="text-xl font-semibold text-gray-900">Novo Evento</h1>
    </div>
    
    <div class="px-6 py-4">
      <%= form_with(model: @evento, local: true, class: "space-y-6") do |form| %>
        <% if @evento.errors.any? %>
          <div class="rounded-md bg-red-50 p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  <%= pluralize(@evento.errors.count, "error") %> prohibited this evento from being saved:
                </h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul class="list-disc list-inside">
                    <% @evento.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <%= form.label :tipo_evento, "Tipo Evento", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :tipo_evento, options_for_select([["Pagamento Semanal", 0], ["Manutenção", 1], ["Multa", 2], ["Outro", 3]], @evento.tipo_evento), { prompt: "Selecione um tipo" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :fluxo, "Fluxo", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :fluxo, options_for_select([["Entrada", 0], ["Saída", 1]], @evento.fluxo), { prompt: "Selecione um fluxo" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :status, "Status", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :status, options_for_select([["Pendente", 0], ["Pago", 1], ["Cancelado", 2]], @evento.status), { prompt: "Selecione um status" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :valor, "Valor", class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :valor, step: 0.01, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :data_evento, "Data Evento", class: "block text-sm font-medium text-gray-700" %>
            <%= form.date_field :data_evento, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :responsavel, "Responsável", class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_field :responsavel, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <%= form.label :cliente_id, "Cliente", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :cliente_id, options_from_collection_for_select(@clientes, :id, :nome, @evento.cliente_id), { prompt: "Selecione um cliente (opcional)" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :veiculo_id, "Veículo", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :veiculo_id, options_from_collection_for_select(@veiculos, :id, :placa_modelo, @evento.veiculo_id), { prompt: "Selecione um veículo (opcional)" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :locacao_id, "Locação", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :locacao_id, options_from_collection_for_select(@locacoes, :id, :numero_contrato, @evento.locacao_id), { prompt: "Selecione uma locação (opcional)" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :tipo_manutencao, "Tipo Manutenção", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :tipo_manutencao, options_for_select([["Preventiva", 0], ["Corretiva", 1], ["Revisão", 2]], @evento.tipo_manutencao), { prompt: "Selecione um tipo (apenas para manutenção)" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <%= form.label :periodo_inicio, "Período Início", class: "block text-sm font-medium text-gray-700" %>
            <%= form.date_field :periodo_inicio, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :periodo_fim, "Período Fim", class: "block text-sm font-medium text-gray-700" %>
            <%= form.date_field :periodo_fim, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :quilometragem, "Quilometragem", class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :quilometragem, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>
        </div>

        <div>
          <%= form.label :descricao, "Descrição", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_area :descricao, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
        </div>

        <div class="flex justify-end space-x-3">
          <%= link_to "Cancelar", eventos_path, class: "px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          <%= form.submit "Salvar Evento", class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
