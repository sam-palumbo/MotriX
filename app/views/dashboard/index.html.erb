<% content_for :title, "Dashboard | MotriX" %>

<% unless database_connected? %>
  <section class="grid gap-4 lg:grid-cols-[2fr_1fr]">
    <div class="rounded-3xl bg-stone-900 p-6 text-white">
      <p class="text-sm font-medium uppercase tracking-[0.25em] text-teal-300">Setup</p>
      <h2 class="mt-2 text-3xl font-semibold">MotriX esta pronto para conectar no PostgreSQL.</h2>
      <p class="mt-4 max-w-2xl text-sm leading-6 text-stone-300">
        O app ja esta configurado para Rails 8, Hotwire, Tailwind, PostgreSQL, Supabase e deploy no Render.
        Falta apenas apontar as variaveis de banco para criar a estrutura.
      </p>
    </div>

    <div class="rounded-3xl border border-stone-200 bg-white p-6">
      <h3 class="text-base font-semibold text-stone-950">Passos rapidos</h3>
      <ol class="mt-4 space-y-3 text-sm text-stone-600">
        <li>1. Configure `DB_HOST`, `DB_NAME`, `DB_USERNAME` e `DB_PASSWORD`.</li>
        <li>2. Rode `bundle exec rake db:create db:migrate db:seed`.</li>
        <li>3. Em producao, use `DATABASE_URL` do Supabase no Render.</li>
      </ol>
    </div>
  </section>

  <section class="mt-6 grid gap-4 md:grid-cols-2">
    <div class="rounded-3xl border border-stone-200 bg-white p-6">
      <h3 class="text-base font-semibold text-stone-950">Ambiente local</h3>
      <div class="mt-4 space-y-2 rounded-2xl bg-stone-950 p-4 text-sm text-stone-100">
        <p>`DB_HOST=127.0.0.1`</p>
        <p>`DB_PORT=5432`</p>
        <p>`DB_NAME=motrix_development`</p>
        <p>`DB_USERNAME=postgres`</p>
        <p>`DB_PASSWORD=...`</p>
      </div>
    </div>

    <div class="rounded-3xl border border-stone-200 bg-white p-6">
      <h3 class="text-base font-semibold text-stone-950">Supabase + Render</h3>
      <div class="mt-4 space-y-2 rounded-2xl bg-stone-950 p-4 text-sm text-stone-100">
        <p>`DATABASE_URL=postgresql://...`</p>
        <p>`SUPABASE_URL=https://...supabase.co`</p>
        <p>`SUPABASE_ANON_KEY=...`</p>
        <p>`SUPABASE_SERVICE_ROLE_KEY=...`</p>
        <p>`RAILS_MASTER_KEY=...`</p>
      </div>
    </div>
  </section>
<% else %>
  <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="rounded-3xl bg-white p-5 shadow-sm ring-1 ring-stone-200">
      <p class="text-sm text-stone-500">Clientes ativos e historicos</p>
      <p class="mt-3 text-3xl font-semibold text-stone-950"><%= @clientes_count %></p>
    </div>
    <div class="rounded-3xl bg-white p-5 shadow-sm ring-1 ring-stone-200">
      <p class="text-sm text-stone-500">Veiculos cadastrados</p>
      <p class="mt-3 text-3xl font-semibold text-stone-950"><%= @veiculos_count %></p>
      <p class="mt-2 text-sm text-emerald-700"><%= @veiculos_disponiveis_count %> disponiveis</p>
    </div>
    <div class="rounded-3xl bg-white p-5 shadow-sm ring-1 ring-stone-200">
      <p class="text-sm text-stone-500">Locacoes abertas</p>
      <p class="mt-3 text-3xl font-semibold text-stone-950"><%= @locacoes_ativas_count %></p>
    </div>
    <div class="rounded-3xl bg-white p-5 shadow-sm ring-1 ring-stone-200">
      <p class="text-sm text-stone-500">Saldo dos ultimos 30 dias</p>
      <p class="mt-3 text-3xl font-semibold text-stone-950"><%= brl(@receita_periodo - @despesas_periodo) %></p>
      <p class="mt-2 text-sm text-stone-500">Entradas <%= brl(@receita_periodo) %> • Saidas <%= brl(@despesas_periodo) %></p>
    </div>
  </section>

  <section class="mt-6 grid gap-6 xl:grid-cols-2">
    <div class="rounded-3xl border border-stone-200 bg-white p-6">
      <div class="flex items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-semibold text-stone-950">Pagamento semanal</h2>
          <p class="mt-1 text-sm text-stone-500">Cria um evento de entrada e ajusta o status da locacao.</p>
        </div>
      </div>

      <%= form_with url: pagamento_semanal_path, class: "mt-6 space-y-4" do |form| %>
        <div>
          <%= form.label :locacao_id, "Contrato", class: "mb-2 block text-sm font-medium text-stone-700" %>
          <%= form.select :locacao_id, @locacoes_para_pagamento.map { |locacao| ["#{locacao.numero_contrato} - #{locacao.cliente.nome}", locacao.id] }, { prompt: "Selecione uma locacao" } %>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= form.label :valor, "Valor", class: "mb-2 block text-sm font-medium text-stone-700" %>
            <%= form.number_field :valor, step: "0.01", min: 0, value: 420 %>
          </div>
          <div>
            <%= form.label :status, "Status", class: "mb-2 block text-sm font-medium text-stone-700" %>
            <%= form.select :status, Evento.statuses.keys.map { |key| [enum_label(key), key] }, selected: "pago" %>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= form.label :periodo_inicio, "Periodo inicial", class: "mb-2 block text-sm font-medium text-stone-700" %>
            <%= form.date_field :periodo_inicio, value: Date.current.beginning_of_week %>
          </div>
          <div>
            <%= form.label :periodo_fim, "Periodo final", class: "mb-2 block text-sm font-medium text-stone-700" %>
            <%= form.date_field :periodo_fim, value: Date.current.end_of_week %>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= form.label :data_evento, "Data do evento", class: "mb-2 block text-sm font-medium text-stone-700" %>
            <%= form.date_field :data_evento, value: Date.current %>
          </div>
          <div>
            <%= form.label :responsavel, "Responsavel", class: "mb-2 block text-sm font-medium text-stone-700" %>
            <%= form.text_field :responsavel, value: Current.usuario&.nome %>
          </div>
        </div>

        <div>
          <%= form.label :descricao, "Observacoes", class: "mb-2 block text-sm font-medium text-stone-700" %>
          <%= form.text_area :descricao, rows: 3, placeholder: "Ex.: Pagamento referente a semana 18." %>
        </div>

        <%= form.submit "Registrar pagamento", class: "w-full rounded-2xl bg-teal-700 px-4 py-3 text-sm font-semibold text-white transition hover:bg-teal-800" %>
      <% end %>
    </div>

    <div class="rounded-3xl border border-stone-200 bg-white p-6">
      <div>
        <h2 class="text-lg font-semibold text-stone-950">Manutencao</h2>
        <p class="mt-1 text-sm text-stone-500">Cria um evento de saida, atualiza km e muda o veiculo para manutencao.</p>
      </div>

      <%= form_with url: manutencao_path, class: "mt-6 space-y-4" do |form| %>
        <div>
          <%= form.label :veiculo_id, "Veiculo", class: "mb-2 block text-sm font-medium text-stone-700" %>
          <%= form.select :veiculo_id, @veiculos_para_manutencao.map { |veiculo| ["#{veiculo.placa} - #{veiculo.marca} #{veiculo.modelo}", veiculo.id] }, { prompt: "Selecione um veiculo" } %>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= form.label :tipo_manutencao, "Tipo", class: "mb-2 block text-sm font-medium text-stone-700" %>
            <%= form.select :tipo_manutencao, Evento.tipo_manutencaos.keys.map { |key| [enum_label(key), key] }, selected: "revisao" %>
          </div>
          <div>
            <%= form.label :valor, "Valor", class: "mb-2 block text-sm font-medium text-stone-700" %>
            <%= form.number_field :valor, step: "0.01", min: 0, value: 180 %>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= form.label :quilometragem, "Quilometragem", class: "mb-2 block text-sm font-medium text-stone-700" %>
            <%= form.number_field :quilometragem, min: 0 %>
          </div>
          <div>
            <%= form.label :data_evento, "Data do evento", class: "mb-2 block text-sm font-medium text-stone-700" %>
            <%= form.date_field :data_evento, value: Date.current %>
          </div>
        </div>

        <div>
          <%= form.label :responsavel, "Responsavel", class: "mb-2 block text-sm font-medium text-stone-700" %>
          <%= form.text_field :responsavel, value: Current.usuario&.nome %>
        </div>

        <div>
          <%= form.label :descricao, "Descricao", class: "mb-2 block text-sm font-medium text-stone-700" %>
          <%= form.text_area :descricao, rows: 3, placeholder: "Ex.: Troca de oleo e revisao geral." %>
        </div>

        <%= form.submit "Registrar manutencao", class: "w-full rounded-2xl bg-stone-900 px-4 py-3 text-sm font-semibold text-white transition hover:bg-stone-700" %>
      <% end %>
    </div>
  </section>

  <section class="mt-6 grid gap-6 xl:grid-cols-[1.2fr_0.8fr]">
    <div class="rounded-3xl border border-stone-200 bg-white p-6">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-semibold text-stone-950">Locacoes ativas</h2>
        <%= link_to "Ver todas", locacoes_path, class: "text-sm font-medium text-teal-700 hover:text-teal-900" %>
      </div>

      <div class="mt-5 space-y-4">
        <% @locacoes_ativas.each do |locacao| %>
          <article class="rounded-2xl border border-stone-200 p-4">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-base font-semibold text-stone-950"><%= locacao.numero_contrato %></p>
                <p class="mt-1 text-sm text-stone-500"><%= locacao.cliente.nome %> • <%= locacao.veiculo.placa %></p>
              </div>
              <span class="rounded-full px-3 py-1 text-xs font-semibold <%= badge_classes(locacao.status) %>"><%= enum_label(locacao.status) %></span>
            </div>
            <div class="mt-3 flex flex-wrap gap-3 text-sm text-stone-600">
              <span>Inicio <strong><%= l(locacao.data_inicio) %></strong></span>
              <span>Prev. fim <strong><%= l(locacao.data_prevista_fim) %></strong></span>
              <span>Semanal <strong><%= brl(locacao.valor_semanal) %></strong></span>
            </div>
          </article>
        <% end %>
      </div>
    </div>

    <div class="space-y-6">
      <div class="rounded-3xl border border-stone-200 bg-white p-6">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold text-stone-950">Veiculos em manutencao</h2>
          <%= link_to "Ver frota", veiculos_path, class: "text-sm font-medium text-teal-700 hover:text-teal-900" %>
        </div>

        <div class="mt-5 space-y-3">
          <% @veiculos_em_manutencao.each do |veiculo| %>
            <div class="rounded-2xl border border-stone-200 p-4">
              <p class="font-semibold text-stone-950"><%= veiculo.placa %></p>
              <p class="mt-1 text-sm text-stone-500"><%= [veiculo.marca, veiculo.modelo, veiculo.cor].compact.join(" • ") %></p>
            </div>
          <% end %>

          <% if @veiculos_em_manutencao.empty? %>
            <p class="rounded-2xl bg-stone-100 p-4 text-sm text-stone-500">Nenhum veiculo em manutencao neste momento.</p>
          <% end %>
        </div>
      </div>

      <div class="rounded-3xl border border-stone-200 bg-white p-6">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold text-stone-950">Socios e participacoes</h2>
          <%= link_to "Ver socios", socios_path, class: "text-sm font-medium text-teal-700 hover:text-teal-900" %>
        </div>

        <div class="mt-5 space-y-4">
          <% @socios.each do |socio| %>
            <div class="rounded-2xl border border-stone-200 p-4">
              <p class="font-semibold text-stone-950"><%= socio.nome %></p>
              <div class="mt-3 space-y-2 text-sm text-stone-600">
                <% socio.participacao_socios.each do |participacao| %>
                  <div class="flex items-center justify-between gap-3">
                    <span><%= participacao.veiculo.placa %></span>
                    <span><%= participacao.percentual_participacao.to_f %>%</span>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <section class="mt-6 rounded-3xl border border-stone-200 bg-white p-6">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-semibold text-stone-950">Eventos recentes</h2>
      <%= link_to "Ver eventos", eventos_path, class: "text-sm font-medium text-teal-700 hover:text-teal-900" %>
    </div>

    <div class="mt-5 space-y-4">
      <% @eventos_recentes.each do |evento| %>
        <article class="rounded-2xl border border-stone-200 p-4">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <p class="font-semibold text-stone-950"><%= enum_label(evento.tipo_evento) %></p>
              <p class="mt-1 text-sm text-stone-500">
                <%= [evento.cliente&.nome, evento.veiculo&.placa, evento.locacao&.numero_contrato].compact.join(" • ") %>
              </p>
            </div>
            <div class="text-right">
              <span class="rounded-full px-3 py-1 text-xs font-semibold <%= badge_classes(evento.fluxo) %>"><%= enum_label(evento.fluxo) %></span>
              <p class="mt-2 text-sm font-semibold text-stone-950"><%= brl(evento.valor) %></p>
            </div>
          </div>
          <div class="mt-3 flex flex-wrap gap-3 text-sm text-stone-600">
            <span><%= l(evento.data_evento) %></span>
            <% if evento.status.present? %>
              <span class="rounded-full px-3 py-1 text-xs font-semibold <%= badge_classes(evento.status) %>"><%= enum_label(evento.status) %></span>
            <% end %>
            <% if evento.tipo_manutencao.present? %>
              <span><%= enum_label(evento.tipo_manutencao) %></span>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  </section>
<% end %>
