<% content_for :title, "Dashboard | MotriX" %>

<% unless database_connected? %>
  <div class="sec-head">
    <div>
      <div class="sec-title">Configuração</div>
      <div class="sec-sub">MotriX está pronto para conectar no PostgreSQL</div>
    </div>
  </div>

  <div class="card">
    <div class="card-lbl">Setup</div>
    <div class="card-val">O app já está configurado para Rails 8, Hotwire, Tailwind, PostgreSQL, Supabase e deploy no Render.</div>
    <div class="mt12" style="font-size:13px;color:var(--text2)">
      Falta apenas apontar as variáveis de banco para criar a estrutura.
    </div>
  </div>

  <div class="kgrid">
    <div class="kcard">
      <div class="knum" style="font-size:16px">1</div>
      <div class="kdesc">Configure variáveis</div>
    </div>
    <div class="kcard">
      <div class="knum" style="font-size:16px">2</div>
      <div class="kdesc">Rode migrations</div>
    </div>
    <div class="kcard">
      <div class="knum" style="font-size:16px">3</div>
      <div class="kdesc">Configure DATABASE_URL</div>
    </div>
  </div>
<% else %>
  <div class="sec-head">
    <div>
      <div class="sec-title">Dashboard</div>
      <div class="sec-sub">Visão geral da operação</div>
    </div>
  </div>

  <!-- KPIs -->
  <div class="kgrid">
    <div class="kcard">
      <div class="knum" style="color:var(--gold)"><%= @clientes_count %></div>
      <div class="kdesc">Clientes</div>
    </div>
    <div class="kcard">
      <div class="knum" style="color:var(--green)"><%= @veiculos_count %></div>
      <div class="kdesc">Veículos</div>
    </div>
    <div class="kcard">
      <div class="knum" style="color:var(--blue)"><%= @locacoes_ativas_count %></div>
      <div class="kdesc">Locações ativas</div>
    </div>
    <div class="kcard">
      <div class="knum" style="color:var(--orange)"><%= @veiculos_em_manutencao.count %></div>
      <div class="kdesc">Em manutenção</div>
    </div>
  </div>

  <!-- Receita e Retorno -->
  <div class="kgrid">
    <div class="kcard">
      <div class="card-lbl" style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.4px;font-weight:600" id="k-rec-mes-label">Receita mês atual</div>
      <div class="knum mt4" style="font-size:20px;color:var(--green)" id="k-rec-mes"><%= number_to_currency(@receita_mes_atual, unit: "R$ ", separator: ",", delimiter: ".") %></div>
    </div>
    <div class="kcard">
      <div class="card-lbl" style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.4px;font-weight:600">Retorno total</div>
      <div class="knum mt4" style="font-size:20px;color:var(--gold)" id="k-ret-total"><%= number_to_currency(@retorno_total, unit: "R$ ", separator: ",", delimiter: ".") %></div>
    </div>
    <div class="kcard" style="grid-column:span 2">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <div>
          <div class="card-lbl" style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.4px;font-weight:600">Investimento total</div>
          <div class="knum mt4" style="font-size:17px"><%= number_to_currency(@investimento_total, unit: "R$ ", separator: ",", delimiter: ".") %></div>
        </div>
        <div style="text-align:right">
          <div class="card-lbl" style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.4px;font-weight:600">Taxa retorno</div>
          <div class="knum mt4" style="font-size:17px;color:var(--gold)" id="k-taxa"><%= number_to_percentage(@taxa_retorno, precision: 1) %></div>
        </div>
      </div>
      <div class="pbar mt8">
        <div class="pbar-fill" style="width:<%= @taxa_retorno * 100 %>%;background:var(--gold)"></div>
      </div>
    </div>
  </div>

  <!-- Gráfico Receita Mensal -->
  <div class="chart-card">
    <div class="chart-title">Receita Mensal últimos 6 meses</div>
    <div class="bar-chart" id="bar-chart">
      <% @receita_mensal.each do |mes, valor| %>
        <div class="bar-wrap">
          <div class="bar" style="height:<%= (valor / @max_receita_mensal * 80).round %>px;background:var(--green)"></div>
          <div class="bar-lbl"><%= mes[0..2] %></div>
          <div class="bar-val"><%= number_to_currency(valor, unit: "", precision: 0) %></div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Alertas -->
  <div class="sec-lbl" id="alerta-lbl">Alertas</div>
  <div id="alertas">
    <% @alertas.each do |alerta| %>
      <div class="alert a-<%= alerta[:tipo] %>" onclick="window.location.href='<%= alerta[:link] %>'">
        <div class="a-icon"><%= alerta[:icone] %></div>
        <div>
          <div class="a-title"><%= alerta[:titulo] %></div>
          <div class="a-sub"><%= alerta[:descricao] %></div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Disponíveis -->
  <div class="sec-lbl" id="disp-lbl">Disponíveis (<%= @veiculos_disponiveis.size %>)</div>
  <div id="disponiveis">
    <% @veiculos_disponiveis.each do |veiculo| %>
      <div class="li" onclick="window.location.href='<%= veiculo_path(veiculo) %>'">
        <div class="li-icon" style="background:rgba(61,186,110,.1)">🏍️</div>
        <div class="li-body">
          <div class="li-title"><%= veiculo.placa %></div>
          <div class="li-sub"><%= veiculo.modelo %> · <%= veiculo.ano %></div>
        </div>
        <div class="li-right">
          <div class="li-val"><%= number_to_currency(veiculo.valor_semanal, unit: "R$ ", separator: ",", delimiter: ".") %></div>
          <div class="li-date">/semana</div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Formulários -->
  <div class="sec-lbl mt8">Registrar</div>
  
  <div class="kgrid">
    <div class="kcard" style="cursor:pointer" onclick="window.location.href='<%= new_evento_path %>'">
      <div class="li-icon" style="background:rgba(61,186,110,.1);margin-bottom:12px">💰</div>
      <div class="knum" style="font-size:16px">Pagamento</div>
      <div class="kdesc">Registrar semana de locação</div>
    </div>
    <div class="kcard" style="cursor:pointer" onclick="window.location.href='<%= veiculos_path %>'">
      <div class="li-icon" style="background:rgba(224,120,48,.1);margin-bottom:12px">🔧</div>
      <div class="knum" style="font-size:16px">Manutenção</div>
      <div class="kdesc">Serviço ou reparo</div>
    </div>
  </div>

  <!-- Locações Ativas -->
  <div class="sec-lbl">Locações Ativas (<%= @locacoes_ativas.size %>)</div>
  <div id="locacoes-ativas">
    <% @locacoes_ativas.each do |locacao| %>
      <div class="li" onclick="window.location.href='<%= locacao_path(locacao) %>'">
        <div class="li-icon" style="background:var(--bg3)">📄</div>
        <div class="li-body">
          <div class="li-title"><%= locacao.numero_contrato %></div>
          <div class="li-sub"><%= locacao.cliente.nome %> · <%= locacao.veiculo.placa %></div>
          <div class="mt4">
            <span class="badge <%= locacao.status == 0 ? 'b-green' : 'b-orange' %>">
              <%= locacao.status_text %>
            </span>
          </div>
        </div>
        <div class="li-right">
          <div class="li-val"><%= number_to_currency(locacao.valor_semanal, unit: "R$ ", separator: ",", delimiter: ".") %></div>
          <div class="li-date">/semana</div>
        </div>
      </div>
    <% end %>
    
    <% if @locacoes_ativas.empty? %>
      <div class="empty">
        <div class="empty-ico">📄</div>
        <div style="font-size:13px">Nenhuma locação ativa no momento</div>
      </div>
    <% end %>
  </div>

  <!-- Veículos em Manutenção -->
  <% if @veiculos_em_manutencao.any? %>
    <div class="sec-lbl">🔧 Em Manutenção (<%= @veiculos_em_manutencao.count %>)</div>
    <div id="veiculos-manutencao">
      <% @veiculos_em_manutencao.each do |veiculo| %>
        <div class="li" onclick="window.location.href='<%= veiculo_path(veiculo) %>'">
          <div class="li-icon" style="background:rgba(224,120,48,.1)">🔧</div>
          <div class="li-body">
            <div class="li-title"><%= veiculo.placa %></div>
            <div class="li-sub"><%= veiculo.marca %> <%= veiculo.modelo %></div>
          </div>
          <div class="li-right">
            <div class="badge b-orange">Manutenção</div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Eventos Recentes -->
  <div class="sec-lbl">📊 Eventos Recentes</div>
  <div id="eventos-recentes">
    <% @eventos_recentes.each do |evento| %>
      <div class="li" onclick="window.location.href='<%= evento_path(evento) %>'">
        <div class="li-icon" style="background:<%= evento.fluxo == 'entrada' ? 'rgba(61,186,110,.1)' : 'rgba(224,80,80,.1)' %>">
          <%= evento.fluxo == 'entrada' ? '💰' : '💸' %>
        </div>
        <div class="li-body">
          <div class="li-title"><%= enum_label(evento.tipo_evento) %></div>
          <div class="li-sub">
            <%= [evento.cliente&.nome, evento.veiculo&.placa, evento.locacao&.numero_contrato].compact.join(" • ") %>
          </div>
        </div>
        <div class="li-right">
          <div class="li-val" style="color:<%= evento.fluxo == 'entrada' ? 'var(--green)' : 'var(--red)' %>">
            <%= evento.fluxo == 'entrada' ? '+' : '-' %> <%= brl(evento.valor) %>
          </div>
          <div class="li-date"><%= l(evento.data_evento, format: :short) %></div>
        </div>
      </div>
    <% end %>
    
    <% if @eventos_recentes.empty? %>
      <div class="empty">
        <div class="empty-ico">📊</div>
        <div style="font-size:13px">Nenhum evento registrado recentemente</div>
      </div>
    <% end %>
  </div>
<% end %>
