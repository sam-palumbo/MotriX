<div class="max-w-4xl mx-auto">
  <div class="bg-white shadow-sm rounded-lg">
    <div class="px-6 py-4 border-b border-gray-200">
      <div class="flex items-center justify-between">
        <h1 class="text-xl font-semibold text-gray-900">Detalhes da Locação</h1>
        <div class="flex space-x-2">
          <%= link_to "Editar", edit_locacao_path(@locacao), class: "px-3 py-1 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          <%= link_to "Voltar", locacoes_path, class: "px-3 py-1 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        </div>
      </div>
    </div>
    
    <div class="px-6 py-4">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="space-y-4">
          <div>
            <h3 class="text-sm font-medium text-gray-500">Informações da Locação</h3>
            <div class="mt-2 space-y-2">
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Número do Contrato:</span>
                <span class="text-sm font-medium text-gray-900"><%= @locacao.numero_contrato %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Status:</span>
                <span class="px-2 py-1 text-xs font-medium rounded-full 
                  <%= case @locacao.status 
                      when 0 then 'bg-green-100 text-green-800'
                      when 1 then 'bg-gray-100 text-gray-800'
                      when 2 then 'bg-yellow-100 text-yellow-800'
                      end %>">
                  <%= @locacao.status_text %>
                </span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Valor Semanal:</span>
                <span class="text-sm font-medium text-gray-900">R$ <%= number_to_currency(@locacao.valor_semanal, unit: "", separator: ",", delimiter: ".") %></span>
              </div>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-medium text-gray-500">Datas</h3>
            <div class="mt-2 space-y-2">
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Data Início:</span>
                <span class="text-sm font-medium text-gray-900"><%= @locacao.data_inicio.strftime("%d/%m/%Y") %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Data Prevista Fim:</span>
                <span class="text-sm font-medium text-gray-900"><%= @locacao.data_prevista_fim.strftime("%d/%m/%Y") %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Data Fim:</span>
                <span class="text-sm font-medium text-gray-900"><%= @locacao.data_fim&.strftime("%d/%m/%Y") || "Em andamento" %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Dias de Locação:</span>
                <span class="text-sm font-medium text-gray-900"><%= ((@locacao.data_fim || Date.current) - @locacao.data_inicio).to_i %> dias</span>
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-4">
          <div>
            <h3 class="text-sm font-medium text-gray-500">Cliente</h3>
            <div class="mt-2">
              <div class="text-sm font-medium text-gray-900"><%= @locacao.cliente.nome %></div>
              <div class="text-sm text-gray-600"><%= @locacao.cliente.cpf %></div>
              <div class="text-sm text-gray-600"><%= @locacao.cliente.telefone %></div>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-medium text-gray-500">Veículo</h3>
            <div class="mt-2">
              <div class="text-sm font-medium text-gray-900"><%= @locacao.veiculo.placa %> - <%= @locacao.veiculo.modelo %></div>
              <div class="text-sm text-gray-600"><%= @locacao.veiculo.marca %> <%= @locacao.veiculo.ano %></div>
              <div class="text-sm text-gray-600">KM Atual: <%= @locacao.veiculo.km_atual %> km</div>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-medium text-gray-500">Caução</h3>
            <div class="mt-2 space-y-2">
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Valor:</span>
                <span class="text-sm font-medium text-gray-900">R$ <%= number_to_currency(@locacao.caucao_valor, unit: "", separator: ",", delimiter: ".") %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Recebida:</span>
                <span class="text-sm font-medium text-gray-900"><%= @locacao.caucao_recebida? ? "Sim" : "Não" %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-sm text-gray-600">Devolvida:</span>
                <span class="text-sm font-medium text-gray-900"><%= @locacao.caucao_devolvida? ? "Sim" : "Não" %></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <% if @locacao.observacoes.present? %>
        <div class="mt-6">
          <h3 class="text-sm font-medium text-gray-500">Observações</h3>
          <div class="mt-2">
            <p class="text-sm text-gray-900"><%= @locacao.observacoes %></p>
          </div>
        </div>
      <% end %>

      <div class="mt-6 pt-6 border-t border-gray-200">
        <div class="flex justify-between items-center text-sm text-gray-500">
          <div>
            Criado em: <%= @locacao.created_at.strftime("%d/%m/%Y %H:%M") %>
          </div>
          <div>
            Atualizado em: <%= @locacao.updated_at.strftime("%d/%m/%Y %H:%M") %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
