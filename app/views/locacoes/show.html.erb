<div class="sec-head">
  <div>
    <div class="sec-title">Detalhes da Locação</div>
    <div class="sec-sub">Informações da locação</div>
  </div>
  <div class="btn-row">
    <%= link_to "Editar", edit_locacao_path(@locacao), class: "btn btn-ghost" %>
    <%= link_to "Voltar", locacoes_path, class: "btn btn-ghost" %>
  </div>
</div>

<!-- Informações da Locação -->
<div class="card">
  <div class="card-lbl">Informações da Locação</div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Número do Contrato</div>
      <div class="fvalue"><%= @locacao.numero_contrato %></div>
    </div>
    <div class="fg">
      <div class="flabel">Status</div>
      <div class="flex items-center gap-2">
        <span class="badge 
          <%= case @locacao.status 
              when 0 then 'b-green'
              when 1 then 'b-gray'
              when 2 then 'b-yellow'
              end %>">
          <%= @locacao.status_text %>
        </span>
      </div>
    </div>
  </div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Valor Semanal</div>
      <div class="fvalue">R$ <%= number_to_currency(@locacao.valor_semanal, unit: "", separator: ",", delimiter: ".") %></div>
    </div>
  </div>
</div>

<!-- Datas -->
<div class="card">
  <div class="card-lbl">Datas</div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Data Início</div>
      <div class="fvalue"><%= @locacao.data_inicio.strftime("%d/%m/%Y") %></div>
    </div>
    <div class="fg">
      <div class="flabel">Data Prevista Fim</div>
      <div class="fvalue"><%= @locacao.data_prevista_fim.strftime("%d/%m/%Y") %></div>
    </div>
  </div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Data Fim</div>
      <div class="fvalue"><%= @locacao.data_fim&.strftime("%d/%m/%Y") || "Em andamento" %></div>
    </div>
    <div class="fg">
      <div class="flabel">Dias de Locação</div>
      <div class="fvalue"><%= ((@locacao.data_fim || Date.current) - @locacao.data_inicio).to_i %> dias</div>
    </div>
  </div>
</div>

<!-- Cliente -->
<div class="card">
  <div class="card-lbl">Cliente</div>
  <div class="frow">
    <div class="fg">
      <div class="fvalue">
        <div><%= @locacao.cliente.nome %></div>
        <div class="text-sm text-gray-600"><%= @locacao.cliente.cpf %></div>
        <div class="text-sm text-gray-600"><%= @locacao.cliente.telefone %></div>
      </div>
    </div>
  </div>
</div>

<!-- Veículo -->
<div class="card">
  <div class="card-lbl">Veículo</div>
  <div class="frow">
    <div class="fg">
      <div class="fvalue">
        <div><%= @locacao.veiculo.placa %> - <%= @locacao.veiculo.modelo %></div>
        <div class="text-sm text-gray-600"><%= @locacao.veiculo.marca %> <%= @locacao.veiculo.ano %></div>
        <div class="text-sm text-gray-600">KM Atual: <%= @locacao.veiculo.km_atual %> km</div>
      </div>
    </div>
  </div>
</div>

<!-- Caução -->
<div class="card">
  <div class="card-lbl">Caução</div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Valor</div>
      <div class="fvalue">R$ <%= number_to_currency(@locacao.caucao_valor, unit: "", separator: ",", delimiter: ".") %></div>
    </div>
    <div class="fg">
      <div class="flabel">Recebida</div>
      <div class="fvalue"><%= @locacao.caucao_recebida? ? "Sim" : "Não" %></div>
    </div>
  </div>
  <div class="frow">
    <div class="fg">
      <div class="flabel">Devolvida</div>
      <div class="fvalue"><%= @locacao.caucao_devolvida? ? "Sim" : "Não" %></div>
    </div>
  </div>
</div>

<% if @locacao.observacoes.present? %>
<!-- Observações -->
<div class="card">
  <div class="card-lbl">Observações</div>
  <div class="frow">
    <div class="fg">
      <div class="fvalue"><%= @locacao.observacoes %></div>
    </div>
  </div>
</div>
<% end %>
