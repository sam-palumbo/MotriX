<% content_for :title, "Locacoes | MotriX" %>

<section class="flex items-end justify-between gap-4">
  <div>
    <p class="text-sm font-medium uppercase tracking-[0.2em] text-teal-700">Locacoes</p>
    <h2 class="mt-1 text-3xl font-semibold text-stone-950">Contratos e operacao</h2>
  </div>
  <div class="flex items-center gap-3">
    <div class="rounded-full bg-white px-4 py-2 text-sm font-medium text-stone-600 ring-1 ring-stone-200">
      <%= @locacoes.size %> contratos
    </div>
    <%= link_to "Nova Locação", new_locacao_path, class: "rounded-full bg-teal-700 px-4 py-2 text-sm font-medium text-white hover:bg-teal-800 transition-colors" %>
  </div>
</section>

<section class="mt-6 space-y-4">
  <% @locacoes.each do |locacao| %>
    <article class="rounded-3xl border border-stone-200 bg-white p-5">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h3 class="text-lg font-semibold text-stone-950"><%= locacao.numero_contrato %></h3>
          <p class="mt-1 text-sm text-stone-500"><%= locacao.cliente.nome %> • <%= locacao.veiculo.placa %></p>
        </div>
        <span class="rounded-full px-3 py-1 text-xs font-semibold <%= badge_classes(locacao.status) %>"><%= enum_label(locacao.status) %></span>
      </div>

      <div class="mt-4 grid gap-3 text-sm text-stone-600 sm:grid-cols-2 xl:grid-cols-4">
        <p><strong>Inicio:</strong> <%= l(locacao.data_inicio) %></p>
        <p><strong>Fim previsto:</strong> <%= l(locacao.data_prevista_fim) %></p>
        <p><strong>Semanal:</strong> <%= brl(locacao.valor_semanal) %></p>
        <p><strong>Caucao:</strong> <%= brl(locacao.caucao_valor) %></p>
      </div>
    </article>
  <% end %>
</section>
