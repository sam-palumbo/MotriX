<% content_for :title, "Locações | MotriX" %>

<div class="sec-head">
  <div>
    <div class="sec-title">Locações</div>
    <div class="sec-sub"><%= @locacoes.size %> contratos ativos</div>
  </div>
  <%= link_to "Nova Locação", "#", onclick: "AppModal.load('#{new_locacao_path}', 'Nova Locação', 'Criar contrato de locação'); return false;", class: "btn btn-gold btn-sm" %>
</div>

<!-- Tabs -->
<div class="tabs">
  <button class="tab active" onclick="filterLocacoes('todos', this)">Todos</button>
  <button class="tab" onclick="filterLocacoes('ativa', this)">Ativas</button>
  <button class="tab" onclick="filterLocacoes('finalizada', this)">Finalizadas</button>
  <button class="tab" onclick="filterLocacoes('cancelada', this)">Canceladas</button>
</div>

<div id="locacoes-list">
  <% @locacoes.each do |locacao| %>
    <div class="vcard" data-status="<%= locacao.status %>" onclick="window.location.href='<%= locacao_path(locacao) %>'">
      <div class="vc-head">
        <div class="vc-plate" style="background:<%= locacao.status == 'ativa' ? 'var(--green)' : locacao.status == 'finalizada' ? 'var(--blue)' : 'var(--red)' %>">
          <%= locacao.numero_contrato %>
        </div>
        <div class="flex1" style="padding-left:4px">
          <div style="font-size:12px;font-weight:600;line-height:1.4">
            <%= locacao.cliente.nome %> • <%= locacao.veiculo.placa %>
          </div>
          <div style="margin-top:4px;display:flex;gap:5px;flex-wrap:wrap">
            <span class="badge <%= locacao.status == 'ativa' ? 'b-green' : locacao.status == 'finalizada' ? 'b-blue' : 'b-red' %>">
              <%= enum_label(locacao.status) %>
            </span>
            <span class="badge b-gold">📅 <%= locacao.data_inicio.strftime("%d/%m/%Y") %></span>
          </div>
        </div>
      </div>
      <div class="vc-body">
        <div class="vc-stats">
          <div class="vc-stat">
            <div class="vc-sn" style="font-size:11px"><%= brl(locacao.valor_semanal) %></div>
            <div class="vc-sl">/semana</div>
          </div>
          <div class="vc-stat">
            <div class="vc-sn" style="color:var(--gold)"><%= brl(locacao.caucao_valor) %></div>
            <div class="vc-sl">caução</div>
          </div>
          <div class="vc-stat">
            <div class="vc-sn" style="font-size:11px">
              <% if locacao.data_prevista_fim.present? %>
                <%= ((locacao.data_prevista_fim - Date.current).to_i) %>d
              <% else %>
                -
              <% end %>
            </div>
            <div class="vc-sl">restantes</div>
          </div>
        </div>
        
        <div class="vc-client">
          <span style="color:var(--text3)">Período</span>
          <span style="font-weight:600;font-size:11px">
            <%= locacao.data_inicio.strftime("%d/%m/%Y") %> → <%= locacao.data_prevista_fim ? locacao.data_prevista_fim.strftime("%d/%m/%Y") : "Indefinido" %>
          </span>
        </div>
      </div>
    </div>
  <% end %>
  
  <% if @locacoes.empty? %>
    <div class="empty">
      <div class="empty-ico">📋</div>
      <div style="font-size:13px">Nenhuma locação cadastrada</div>
    </div>
  <% end %>
</div>

<script>
function filterLocacoes(status, element) {
  // Update active tab
  document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('active'));
  element.classList.add('active');
  
  // Filter locacoes
  const locacoes = document.querySelectorAll('.vcard');
  locacoes.forEach(locacao => {
    if (status === 'todos') {
      locacao.style.display = 'block';
    } else {
      locacao.style.display = locacao.dataset.status === status ? 'block' : 'none';
    }
  });
}
</script>
