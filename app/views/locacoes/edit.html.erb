<div class="sec-head">
  <div>
    <div class="sec-title">Editar Locação</div>
    <div class="sec-sub">Atualizar informações da locação</div>
  </div>
</div>

<%= form_with(model: @locacao, local: true, class: "max-w-2xl") do |form| %>
  <% if @locacao.errors.any? %>
    <div class="alert a-red">
      <div class="a-icon">⚠</div>
      <div>
        <div class="a-title">Erros no formulário</div>
        <div class="a-sub">
          <% @locacao.errors.full_messages.each do |message| %>
            • <%= message %><br>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Dados da Locação -->
  <div class="card">
    <div class="card-lbl">Dados da Locação</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :numero_contrato, "Número do Contrato", class: "flabel" %>
        <%= form.text_field :numero_contrato, class: "finput", placeholder: "Número do contrato" %>
      </div>
      <div class="fg">
        <%= form.label :cliente_id, "Cliente", class: "flabel" %>
        <%= form.select :cliente_id, 
            options_from_collection_for_select(@clientes, :id, :nome, @locacao.cliente_id), 
            { prompt: "Selecione um cliente" }, 
            class: "fselect" %>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <%= form.label :veiculo_id, "Veículo", class: "flabel" %>
        <%= form.select :veiculo_id, 
            options_from_collection_for_select(@veiculos, :id, :placa_modelo, @locacao.veiculo_id), 
            { prompt: "Selecione um veículo" }, 
            class: "fselect" %>
      </div>
      <div class="fg">
        <%= form.label :status, "Status", class: "flabel" %>
        <%= form.select :status, 
            options_for_select([
              ["Ativa", 0], 
              ["Finalizada", 1], 
              ["Suspensa", 2]
            ], @locacao.status), 
            {}, 
            class: "fselect" %>
      </div>
    </div>
  </div>

  <!-- Período e Valores -->
  <div class="card">
    <div class="card-lbl">Período e Valores</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :data_inicio, "Data Início", class: "flabel" %>
        <%= form.date_field :data_inicio, class: "finput" %>
      </div>
      <div class="fg">
        <%= form.label :data_prevista_fim, "Data Prevista Fim", class: "flabel" %>
        <%= form.date_field :data_prevista_fim, class: "finput" %>
      </div>
    </div>
    <div class="frow">
      <div class="fg">
        <%= form.label :data_fim, "Data Fim", class: "flabel" %>
        <%= form.date_field :data_fim, class: "finput" %>
      </div>
      <div class="fg">
        <%= form.label :valor_semanal, "Valor Semanal", class: "flabel" %>
        <%= form.number_field :valor_semanal, step: 0.01, class: "finput", placeholder: "0.00" %>
      </div>
    </div>
  </div>

  <!-- Caução -->
  <div class="card">
    <div class="card-lbl">Caução</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :caucao_valor, "Valor Caução", class: "flabel" %>
        <%= form.number_field :caucao_valor, step: 0.01, class: "finput", placeholder: "0.00" %>
      </div>
    </div>
    <div class="frow">
      <div class="fg" style="display:flex;align-items:center;gap:16px;padding-top:20px">
        <div style="display:flex;align-items:center;gap:8px">
          <%= form.check_box :caucao_recebida, class: "form-check-input", style: "width:18px;height:18px;accent-color:var(--gold)" %>
          <%= form.label :caucao_recebida, "Caução Recebida", class: "flabel", style: "margin:0;font-weight:500" %>
        </div>
        <div style="display:flex;align-items:center;gap:8px">
          <%= form.check_box :caucao_devolvida, class: "form-check-input", style: "width:18px;height:18px;accent-color:var(--gold)" %>
          <%= form.label :caucao_devolvida, "Caução Devolvida", class: "flabel", style: "margin:0;font-weight:500" %>
        </div>
      </div>
    </div>
  </div>

  <!-- Observações -->
  <div class="card">
    <div class="card-lbl">Observações</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :observacoes, "Observações", class: "flabel" %>
        <%= form.text_area :observacoes, class: "finput", rows: 3, placeholder: "Observações adicionais..." %>
      </div>
    </div>
  </div>

  <!-- Botões -->
  <div class="btn-row">
    <%= link_to "Cancelar", @locacao, class: "btn btn-ghost" %>
    <%= form.submit "Atualizar Locação", class: "btn btn-gold" %>
  </div>
<% end %>
