<div class="sec-head">
  <div>
    <div class="sec-title">Nova Locação</div>
    <div class="sec-sub">Criar contrato de locação</div>
  </div>
</div>

<%= form_with(model: @locacao, local: true, class: "max-w-2xl") do |form| %>
  <% if @locacao.errors.any? %>
    <div class="alert a-red">
      <div class="a-icon">⚠</div>
      <div>
        <div class="a-title">Erros no formulário</div>
        <div class="a-sub">
          <% @locacao.errors.full_messages.each do |message| %>
            • <%= message %><br>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Dados do Contrato -->
  <div class="card">
    <div class="card-lbl">Dados do Contrato</div>
    <div class="fg">
      <%= form.label :numero_contrato, "Número do Contrato", class: "flabel" %>
      <%= form.text_field :numero_contrato, class: "finput", placeholder: "LOC-2024-001" %>
    </div>
    <div class="frow">
      <div class="fg">
        <%= form.label :cliente_id, "Cliente", class: "flabel" %>
        <%= form.select :cliente_id, 
            options_from_collection_for_select(@clientes, :id, :nome, @locacao.cliente_id), 
            { prompt: "Selecione um cliente" }, 
            class: "fselect" %>
      </div>
      <div class="fg">
        <%= form.label :veiculo_id, "Veículo", class: "flabel" %>
        <%= form.select :veiculo_id, 
            options_from_collection_for_select(@veiculos, :id, :placa_modelo, @locacao.veiculo_id), 
            { prompt: "Selecione um veículo" }, 
            class: "fselect" %>
      </div>
    </div>
    <div class="fg">
      <%= form.label :status, "Status", class: "flabel" %>
      <%= form.select :status, 
          options_for_select([
            ["Ativa", 0], 
            ["Finalizada", 1], 
            ["Suspensa", 2]
          ], @locacao.status || 0), 
          {}, class: "fselect" %>
    </div>
  </div>

  <!-- Período -->
  <div class="card">
    <div class="card-lbl">Período da Locação</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :data_inicio, "Data Início", class: "flabel" %>
        <%= form.date_field :data_inicio, class: "finput", value: Date.current %>
      </div>
      <div class="fg">
        <%= form.label :data_prevista_fim, "Data Prevista Fim", class: "flabel" %>
        <%= form.date_field :data_prevista_fim, class: "finput" %>
      </div>
    </div>
    <div class="fg">
      <%= form.label :data_fim, "Data Fim (real)", class: "flabel" %>
      <%= form.date_field :data_fim, class: "finput", placeholder: "Preencher quando finalizar" %>
    </div>
  </div>

  <!-- Valores -->
  <div class="card">
    <div class="card-lbl">Valores Financeiros</div>
    <div class="frow">
      <div class="fg">
        <%= form.label :valor_semanal, "Valor Semanal (R$)", class: "flabel" %>
        <%= form.number_field :valor_semanal, step: 0.01, class: "finput", placeholder: "330,00" %>
      </div>
      <div class="fg">
        <%= form.label :caucao_valor, "Valor Caução (R$)", class: "flabel" %>
        <%= form.number_field :caucao_valor, step: 0.01, class: "finput", placeholder: "500,00" %>
      </div>
    </div>
    
    <div class="frow" style="margin-top:12px">
      <div class="fg" style="display:flex;align-items:center;gap:8px">
        <%= form.check_box :caucao_recebida, class: "form-check-input", style: "width:18px;height:18px;accent-color:var(--gold)" %>
        <%= form.label :caucao_recebida, "Caução Recebida", class: "flabel", style: "margin:0;font-weight:500" %>
      </div>
      <div class="fg" style="display:flex;align-items:center;gap:8px">
        <%= form.check_box :caucao_devolvida, class: "form-check-input", style: "width:18px;height:18px;accent-color:var(--gold)" %>
        <%= form.label :caucao_devolvida, "Caução Devolvida", class: "flabel", style: "margin:0;font-weight:500" %>
      </div>
    </div>
  </div>

  <!-- Observações -->
  <div class="card">
    <div class="card-lbl">Observações</div>
    <div class="fg">
      <%= form.label :observacoes, "Observações sobre a locação", class: "flabel" %>
      <%= form.text_area :observacoes, class: "ftextarea", placeholder: "Detalhes importantes sobre o contrato..." %>
    </div>
  </div>

  <!-- Botões -->
  <div class="btn-row">
    <%= link_to "Cancelar", locacoes_path, class: "btn btn-ghost" %>
    <%= form.submit "Criar Locação", class: "btn btn-gold" %>
  </div>
<% end %>
