<div class="max-w-2xl mx-auto">
  <div class="bg-white shadow-sm rounded-lg">
    <div class="px-6 py-4 border-b border-gray-200">
      <h1 class="text-xl font-semibold text-gray-900">Nova Locação</h1>
    </div>
    
    <div class="px-6 py-4">
      <%= form_with(model: @locacao, local: true, class: "space-y-6") do |form| %>
        <% if @locacao.errors.any? %>
          <div class="rounded-md bg-red-50 p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  <%= pluralize(@locacao.errors.count, "error") %> prohibited this locacao from being saved:
                </h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul class="list-disc list-inside">
                    <% @locacao.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <%= form.label :numero_contrato, "Número do Contrato", class: "block text-sm font-medium text-gray-700" %>
            <%= form.text_field :numero_contrato, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :cliente_id, "Cliente", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :cliente_id, options_from_collection_for_select(@clientes, :id, :nome, @locacao.cliente_id), { prompt: "Selecione um cliente" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :veiculo_id, "Veículo", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :veiculo_id, options_from_collection_for_select(@veiculos, :id, :placa_modelo, @locacao.veiculo_id), { prompt: "Selecione um veículo" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :status, "Status", class: "block text-sm font-medium text-gray-700" %>
            <%= form.select :status, options_for_select([["Ativa", 0], ["Finalizada", 1], ["Suspensa", 2]], @locacao.status), {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <%= form.label :data_inicio, "Data Início", class: "block text-sm font-medium text-gray-700" %>
            <%= form.date_field :data_inicio, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :data_prevista_fim, "Data Prevista Fim", class: "block text-sm font-medium text-gray-700" %>
            <%= form.date_field :data_prevista_fim, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :data_fim, "Data Fim", class: "block text-sm font-medium text-gray-700" %>
            <%= form.date_field :data_fim, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div>
            <%= form.label :valor_semanal, "Valor Semanal", class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :valor_semanal, step: 0.01, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <%= form.label :caucao_valor, "Valor Caução", class: "block text-sm font-medium text-gray-700" %>
            <%= form.number_field :caucao_valor, step: 0.01, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>

          <div class="space-y-3">
            <div class="flex items-center">
              <%= form.check_box :caucao_recebida, class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
              <%= form.label :caucao_recebida, "Caução Recebida", class: "ml-2 block text-sm text-gray-900" %>
            </div>
            <div class="flex items-center">
              <%= form.check_box :caucao_devolvida, class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
              <%= form.label :caucao_devolvida, "Caução Devolvida", class: "ml-2 block text-sm text-gray-900" %>
            </div>
          </div>
        </div>

        <div>
          <%= form.label :observacoes, "Observações", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_area :observacoes, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
        </div>

        <div class="flex justify-end space-x-3">
          <%= link_to "Cancelar", locacoes_path, class: "px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          <%= form.submit "Salvar Locação", class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
